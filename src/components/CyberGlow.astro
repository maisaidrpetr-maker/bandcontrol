---
// src/components/CyberGlow.astro
---

<div id="cyber-glow-element" class="glow-under off"></div>

<style>
  .glow-under {
    position: absolute;
    /* Přesný čtvercový rozměr pod nožičky SOIC čipu */
    width: 370px; 
    height: 370px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    border-radius: 0px !important;
    box-sizing: border-box;
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Výchozí stav - tma */
  .off {
    background: transparent;
    box-shadow: none;
  }

  /* Stabilní zelená záře (Úspěch) - plynule slábne do prostoru */
  .green {
    background: rgba(0, 255, 0, 0.4);
    box-shadow: 
      0 0 35px 15px rgba(0, 255, 0, 0.65),
      0 0 75px 35px rgba(0, 200, 0, 0.35),
      0 0 140px 60px rgba(0, 120, 0, 0.15),
      0 0 220px 90px rgba(0, 50, 0, 0.05);
  }

  /* Třída pro spuštění trojitého červeného bliknutí */
  .blink-red {
    animation: error-blink-sequence 2s ease forwards;
  }

  @keyframes error-blink-sequence {
    0%, 20%, 40%, 60% {
      background: rgba(255, 0, 0, 0.35);
      box-shadow: 
        0 0 30px 10px rgba(255, 0, 0, 0.6),
        0 0 60px 25px rgba(200, 0, 0, 0.3),
        0 0 110px 45px rgba(150, 0, 0, 0.1);
    }
    10%, 30%, 50%, 70% {
      background: transparent;
      box-shadow: none;
    }
    100% {
      background: transparent;
      box-shadow: none;
    }
  }
</style>