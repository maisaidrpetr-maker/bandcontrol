---
/* src/components/EventsModule.astro */
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
const now = new Date();
now.setHours(0, 0, 0, 0);

const getLocalMidnight = (dateVal: Date) => new Date(dateVal.getFullYear(), dateVal.getMonth(), dateVal.getDate()).getTime();
const sortedAll = allEvents.sort((a, b) => getLocalMidnight(a.data.date) - getLocalMidnight(b.data.date));

const nextEventIndex = sortedAll.findIndex(event => getLocalMidnight(event.data.date) >= now.getTime());

// Rozdělení dat
let future = nextEventIndex !== -1 ? sortedAll.slice(nextEventIndex + 1) : [];
let middle = nextEventIndex !== -1 ? sortedAll.slice(nextEventIndex, nextEventIndex + 1) : [];
let past = nextEventIndex !== -1 ? sortedAll.slice(0, nextEventIndex) : sortedAll;

const MAX_TOTAL = 15;
let finalFuture = future.reverse(); 
let finalPast = past.reverse();

const totalList = [...finalFuture, ...middle, ...finalPast].slice(0, MAX_TOTAL);

const topEvents = totalList.filter(e => future.includes(e));
const middleEvents = totalList.filter(e => middle.includes(e));
const bottomEvents = totalList.filter(e => past.includes(e));

const formatDate = (dateVal: Date) => `${String(dateVal.getDate()).padStart(2, '0')}.${String(dateVal.getMonth() + 1).padStart(2, '0')}.`;
const getEventColor = (event: any) => event.data.alert ? '#ff4500' : '#b87333';
---

<div class="sidebar-v-unit">
  <div class="v-plate">
    <div class="engraved-label">Events</div>
    
    <div class="v-window top-window">
      <div class="events-list">
        {topEvents.map(event => (
          <div class="event-item">
            <span class="event-type" style={`color: ${getEventColor(event)}`}>{event.data.type}</span>
            <span class="event-date" style={`color: ${getEventColor(event)}`}>{formatDate(event.data.date)}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="bridge-gap"></div>

    <div class="highlight-window">
      {middleEvents.map(event => (
        <div class="event-item highlight-item">
          <span class="event-type">{event.data.type}</span>
          <span class="event-date">{formatDate(event.data.date)}</span>
        </div>
      ))}
    </div>

    <div class="bridge-gap"></div>

    <div class="v-window bottom-window">
      <div class="events-list is-history">
        {bottomEvents.map(event => (
          <div class="event-item is-past">
            <span class="event-type">{event.data.type}</span>
            <span class="event-date">{formatDate(event.data.date)}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="rivet t-l"></div>
    <div class="rivet t-r"></div>
  </div>
</div>

<style>
  .sidebar-v-unit { display: flex; justify-content: center; width: 100%; }
  
  .v-plate {
    width: 95%;              /* Mobil: 95 % šířky */
    max-width: 280px;        /* Desktop: max 280px */
    margin: 0 auto;          /* Vycentrování */
    height: fit-content;
    background: linear-gradient(135deg, #2c2c2c 0%, #484848 25%, #1a1a1a 50%, #424242 75%, #222222 100%);
    border: 1px solid #000; 
    border-radius: 12px;
    position: relative; 
    padding: 50px 12px 14px 12px;
    display: flex; 
    flex-direction: column; 
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.8), inset 0px 1px 0px rgba(255, 255, 255, 0.45), inset 0px -2px 3px rgba(0, 0, 0, 0.6);
  }

  .engraved-label {
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    text-align: center;
    color: #b87333;
    font-family: sans-serif;
    font-size: 1.5rem;
    font-weight: 550;
    letter-spacing: 0.5px;
    text-shadow: 0px 1px 1px rgba(255, 255, 255, 0.25), 0px -1px 2px rgba(0, 0, 0, 0.9);
  }

  .v-window { 
    width: 100%; 
    background: #000; 
    border-radius: 9px; 
    border: 1px solid rgba(0, 0, 0, 0.9); 
    box-shadow: inset 6px 6px 15px rgba(0, 0, 0, 1), 0px 2px 0px rgba(255, 255, 255, 0.2); 
    flex-grow: 0;
  }
  
  .top-window, .bottom-window { padding: 6px 0; }
  
  .highlight-window { 
    height: 34px; 
    width: 100%; 
    background: #000; 
    border-radius: 9px; 
    border: 1px solid rgba(0, 0, 0, 0.9); 
    box-shadow: inset 6px 6px 15px rgba(0, 0, 0, 1), 0px 2px 0px rgba(255, 255, 255, 0.2); 
    display: flex; 
    align-items: center; 
    flex-grow: 0;
  }  
  .bridge-gap { height: 14px; flex-shrink: 0; }
  .event-item { display: flex; justify-content: space-between; padding: 0px 12px; height: 22px; align-items: center; font-size: 0.95rem; font-family: sans-serif; }
  .highlight-item { color: #e0e0e0; font-weight: bold; width: 100%; }
  .is-past .event-type, .is-past .event-date { color: #444 !important; }
  
  .rivet { position: absolute; width: 9px; height: 9px; background: radial-gradient(circle at 35% 35%, #fff 0%, #222 100%); border-radius: 50%; }
  .t-l { top: 12px; left: 12px; } .t-r { top: 12px; right: 12px; }
</style>