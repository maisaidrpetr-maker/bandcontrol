---
// src/components/EventsModule.astro
---

<div class="sidebar-v-unit">
  <div class="v-plate">
    <div class="engraved-label">Events</div>
    
    <div class="v-window top-window">
      <div class="events-list" id="events-top-list">
        <div class="event-item"><span class="event-type" style="color: #666;">Načítám...</span></div>
      </div>
    </div>

    <div class="bridge-gap"></div>

    <div class="highlight-window" id="events-highlight-window">
      <div class="event-item highlight-item">
        <span class="event-type">Dnes / Nejbližší</span>
        <span class="event-date">--.--.</span>
      </div>
    </div>

    <div class="bridge-gap"></div>

    <div class="v-window bottom-window">
      <div class="events-list is-history" id="events-bottom-list">
      </div>
    </div>

    <div class="rivet t-l"></div>
    <div class="rivet t-r"></div>
  </div>
</div>

<script is:inline>
  async function loadDashboardEvents() {
    try {
      const res = await fetch('/api/events');
      if (!res.ok) throw new Error('Chyba při načítání událostí');
      
      const rawEvents = await res.json();
      if (!Array.isArray(rawEvents) || rawEvents.length === 0) return;

      // Transformace a seřazení dat (očekáváme pole objektů s title/type a date)
      const now = new Date();
      now.setHours(0, 0, 0, 0);
      const nowTime = now.getTime();

      const getLocalMidnight = (dateStr) => {
        const d = new Date(dateStr);
        return isNaN(d.getTime()) ? 0 : new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
      };

      const formatDate = (dateStr) => {
        const d = new Date(dateStr);
        if (isNaN(d.getTime())) return 'Neurčeno';
        return `${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}.`;
      };

      // Mapování dat z DB formátu do šablony
      const formattedEvents = rawEvents.map(ev => ({
        type: ev.title || ev.type || 'Akce',
        dateVal: ev.date ? new Date(ev.date) : new Date(),
        timestamp: getLocalMidnight(ev.date),
        alert: ev.alert || false
      })).sort((a, b) => a.timestamp - b.timestamp);

      const nextEventIndex = formattedEvents.findIndex(e => e.timestamp >= nowTime);

      let future = nextEventIndex !== -1 ? formattedEvents.slice(nextEventIndex + 1) : [];
      let middle = nextEventIndex !== -1 ? formattedEvents.slice(nextEventIndex, nextEventIndex + 1) : [];
      let past = nextEventIndex !== -1 ? formattedEvents.slice(0, nextEventIndex) : formattedEvents;

      const MAX_TOTAL = 15;
      let finalFuture = [...future].reverse();
      let finalPast = [...past].reverse();

      const totalList = [...finalFuture, ...middle, ...finalPast].slice(0, MAX_TOTAL);

      const topEvents = totalList.filter(e => future.includes(e));
      const middleEvents = totalList.filter(e => middle.includes(e));
      const bottomEvents = totalList.filter(e => past.includes(e));

      // Vykreslení TOP (budoucí)
      const topContainer = document.getElementById('events-top-list');
      if (topContainer) {
        topContainer.innerHTML = topEvents.length > 0 
          ? topEvents.map(e => `
              <div class="event-item">
                <span class="event-type" style="color: ${e.alert ? '#ff4500' : '#b87333'}">${e.type}</span>
                <span class="event-date" style="color: ${e.alert ? '#ff4500' : '#b87333'}">${formatDate(e.dateVal)}</span>
              </div>
            `).join('')
          : '<div class="event-item"><span class="event-type" style="color: #444;">Žádné další</span></div>';
      }

      // Vykreslení MIDDLE (dnešní / nejbližší aktivní)
      const highlightContainer = document.getElementById('events-highlight-window');
      if (highlightContainer) {
        highlightContainer.innerHTML = middleEvents.length > 0
          ? middleEvents.map(e => `
              <div class="event-item highlight-item">
                <span class="event-type">${e.type}</span>
                <span class="event-date">${formatDate(e.dateVal)}</span>
              </div>
            `).join('')
          : '<div class="event-item highlight-item"><span class="event-type">Žádná akce</span><span class="event-date">--.--.</span></div>';
      }

      // Vykreslení BOTTOM (minulé)
      const bottomContainer = document.getElementById('events-bottom-list');
      if (bottomContainer) {
        bottomContainer.innerHTML = bottomEvents.length > 0
          ? bottomEvents.map(e => `
              <div class="event-item is-past">
                <span class="event-type">${e.type}</span>
                <span class="event-date">${formatDate(e.dateVal)}</span>
              </div>
            `).join('')
          : '';
      }

    } catch (err) {
      console.error('Nepodařilo se načíst události pro dashboard:', err);
    }
  }

  document.addEventListener('DOMContentLoaded', loadDashboardEvents);
</script>

<style>
  .sidebar-v-unit { display: flex; justify-content: center; width: 100%; }
  
  .v-plate {
    width: 95%; max-width: 280px; margin: 0 auto;
    height: fit-content;
    background: linear-gradient(135deg, #2c2c2c 0%, #484848 25%, #1a1a1a 50%, #424242 75%, #222222 100%);
    border: 1px solid #000; border-radius: 12px;
    position: relative; padding: 50px 12px 14px 12px;
    display: flex; flex-direction: column;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.8), inset 0px 1px 0px rgba(255, 255, 255, 0.45), inset 0px -2px 3px rgba(0, 0, 0, 0.6);
  }

  .engraved-label {
    position: absolute; top: 12px; left: 0; right: 0; text-align: center;
    color: #b87333; font-family: sans-serif; font-size: 1.5rem; font-weight: 550;
    text-shadow: 0px 1px 1px rgba(255, 255, 255, 0.25), 0px -1px 2px rgba(0, 0, 0, 0.9);
  }

  .v-window { width: 100%; background: #000; border-radius: 9px; border: 1px solid rgba(0, 0, 0, 0.9); box-shadow: inset 6px 6px 15px rgba(0, 0, 0, 1), 0px 2px 0px rgba(255, 255, 255, 0.2); flex-grow: 0; }
  .top-window, .bottom-window { padding: 6px 0; max-height: 180px; overflow-y: auto; }
  
  .highlight-window { height: 34px; width: 100%; background: #000; border-radius: 9px; border: 1px solid rgba(0, 0, 0, 0.9); box-shadow: inset 6px 6px 15px rgba(0, 0, 0, 1), 0px 2px 0px rgba(255, 255, 255, 0.2); display: flex; align-items: center; flex-grow: 0; }
  .bridge-gap { height: 14px; flex-shrink: 0; }
  .event-item { display: flex; justify-content: space-between; padding: 0px 12px; height: 22px; align-items: center; font-size: 0.95rem; font-family: sans-serif; }
  .highlight-item { color: #e0e0e0; font-weight: bold; width: 100%; }
  .is-past .event-type, .is-past .event-date { color: #444 !important; }
  
  .rivet { position: absolute; width: 9px; height: 9px; background: radial-gradient(circle at 35% 35%, #fff 0%, #222 100%); border-radius: 50%; }
  .t-l { top: 12px; left: 12px; } .t-r { top: 12px; right: 12px; }
</style>