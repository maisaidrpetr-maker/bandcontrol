---
// src/components/footer.astro
import '../styles/global.css';
---
<footer class="rack-footer">
  <span class="footer-text">
    BandControl - Generated by Astro framework - Petr Maišaidr © 2026
  </span>
</footer>

<style>
  .rack-footer {
    /* Obrácený gradient oproti headeru: #111112 nahoře, #222224 uprostřed, #555558 dole */
    background: linear-gradient(180deg, #111112 0%, #222224 55%, #555558 100%);
    border-top: 2px solid #000;
    box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.8);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0 40px;
    box-sizing: border-box;
    position: relative;
    z-index: 1000;
    min-height: 40px;
    width: 100%;
    margin-top: 0;
  }

  .footer-text {
    color: #888;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    letter-spacing: 1px;
    text-align: center;
  }
</style>