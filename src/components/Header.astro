---
/* src/components/Header.astro */
---
<header class="rack-header">
  
  <div class="user-display-wrapper">
    <div class="user-display">
      <span class="user-char">PETR MAIŠAIDR</span>
      <span class="user-char-instrument">(KYTARA)</span>
    </div>
  </div>

  <div class="controls">
    <button id="fullscreen-btn" class="rack-button" title="Fullscreen Režim">
      <span class="led"></span>
      <span class="label">FULLSCREEN</span>
    </button>
  </div>

  <div class="clock-display-wrapper">
    <div class="clock-display">
      <div id="header-date" class="clock-container"></div>
      <div class="clock-dot-separator">:</div>
      <div id="header-time" class="clock-container"></div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('fullscreen-btn');
  btn?.addEventListener('click', () => {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(err => console.error(err));
    } else {
      document.exitFullscreen();
    }
  });

  function updateClock() {
    const now = new Date();
    const dateEl = document.getElementById('header-date');
    const timeEl = document.getElementById('header-time');

    const createFixedChars = (str) => {
      return str.split('').map(char => {
        let type = 'num';
        let specific = '';
        if (char === '.') { type = 'sep'; specific = 'dot'; }
        else if (char === ':') { type = 'sep'; specific = 'colon'; }
        return `<span class="char ${type} ${specific}">${char}</span>`;
      }).join('');
    };

    if (dateEl) {
      const d = String(now.getDate()).padStart(2, '0');
      const m = String(now.getMonth() + 1).padStart(2, '0');
      const y = now.getFullYear();
      dateEl.innerHTML = createFixedChars(`${d}.${m}.${y}`);
    }
    if (timeEl) {
      const timeStr = now.toLocaleTimeString('cs-CZ', {
        hour: '2-digit', minute: '2-digit', second: '2-digit'
      });
      timeEl.innerHTML = createFixedChars(timeStr);
    }
  }

  updateClock();
  setInterval(updateClock, 1000);

  document.addEventListener('fullscreenchange', () => {
    const led = document.querySelector('.led');
    document.fullscreenElement ? led?.classList.add('active') : led?.classList.remove('active');
  });
</script>

<style>
  @font-face {
    font-family: 'Segment7';
    src: url('/fonts/LED_Dot-Matrix.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
  }

  .rack-header {
    min-height: 60px;
    background: linear-gradient(180deg, #555558 0%, #222224 45%, #111112 100%);
    border-bottom: 4px solid #000000;
    
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 10px 20px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.9);
    position: relative;
    z-index: 100;
    width: 100%;
    box-sizing: border-box;
    gap: 10px;
  }

  .user-display-wrapper { justify-self: start; }
  .controls { justify-self: center; }
  .clock-display-wrapper { justify-self: end; }

  /* 🖥️ UNIFORMÍ KOMPAKTNÍ DISPLEJE */
  .user-display, .clock-display {
    background: #000;
    height: 34px;
    box-sizing: border-box;
    border-radius: 4px;
    border: 1px solid #222;
    box-shadow: inset 0 0 15px rgba(0,0,0,1);
    display: flex;
    align-items: center;
    justify-content: center; /* Všechno tlačíme hezky na střed */
    padding: 0px 16px;
  }

  .user-display {
    width: 250px;
    color: #08d1ce;
    font-family: 'Segment7', monospace;
    font-size: 14px;
    text-shadow: 0 0 8px rgba(8, 209, 206, 0.5);
    gap: 8px; /* Těsnější, přirozená mezera */
  }

  .user-char {
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* 🛠️ OPRAVA: Krásně čitelný nástroj v závorce */
  .user-char-instrument {
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #04908e; /* Jemně utlumená azurová, ale perfektně čitelná */
  }

  /* 🛠️ OPRAVA HODIN: Žádné obří mezery, vše u sebe na středu */
  .clock-display {
    width: 220px; /* Menší, kompaktnější šířka */
    color: #08d1ce;
    font-family: 'Segment7', monospace;
    font-size: 14px;
    text-shadow: 0 0 8px rgba(8, 209, 206, 0.5);
    gap: 12px; /* Přesná mezera mezi datem a časem */
  }

  .clock-container {
    display: flex;
    align-items: center;
  }

  /* Malá jemná tečka/dvojtečka mezi blokem data a času */
  .clock-dot-separator {
    opacity: 0.3;
    font-size: 12px;
    margin-top: -2px;
  }

  /* FIXNÍ ŠÍŘKY DIOD */
  :global(.char.num) {
    display: inline-block;
    width: 10px;
    text-align: center;
  }

  :global(.char.sep) {
    display: inline-block;
    position: relative;
    opacity: 0.8;
  }

  :global(.char.colon) {
    width: 5px;
    text-align: center;
    top: -1px; 
  }

  :global(.char.dot) {
    width: 4px;
    text-align: left;
    margin-left: -1px;
    top: 0px;
  }

  /* FULLSCREEN BTN */
  .rack-button {
    background: #222;
    border: 1px solid #444;
    border-bottom: 3px solid #000;
    color: #888;
    padding: 6px 12px;
    border-radius: 4px;
    font-family: 'Orbitron', sans-serif;
    font-size: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .led {
    width: 8px;
    height: 8px;
    background: rgb(100, 20, 20);
    border-radius: 50%;
    transition: all 0.3s;
  }

  .led.active {
    background: rgb(81, 237, 73);
    box-shadow: 0 0 10px rgb(81, 237, 73);
  }

  .label { text-shadow: 0 1px 0 #000; }

  /* 🛠️ RESPONSIVITA: Skládání pod sebe na malých displejích / při smrštění */
  @media (max-width: 768px) {
    .rack-header {
      grid-template-columns: 1fr; /* Změna gridu na jeden sloupec */
      justify-items: center;
      padding: 12px;
      height: auto;
    }
    .user-display-wrapper, .controls, .clock-display-wrapper {
      justify-self: center; /* Všechno vycentrovat pod sebou */
    }
    .user-display, .clock-display {
      width: 100%;
      max-width: 280px; /* Na mobilu lehce roztáhnout do stran */
    }
  }
</style>