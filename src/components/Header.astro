<header class="rack-header">
  <div class="band-name">BLUE HEART</div>
  
  <div class="user-display">
    <span id="header-user-name" class="user-char">---</span>
    <span id="header-user-role" class="user-role">(---)</span>
  </div>
  
  <a href="#" id="logout-btn" class="rack-btn-logout">LOGOUT</a>
  
  <button id="fullscreen-btn" class="rack-btn-fs">
    <span class="led"></span>
    <span class="label">FULLSCREEN</span>
  </button>
  
  <div class="right-section">
    <div class="clock-box" id="header-date">--.--.----</div>
    <div class="clock-box" id="header-time">--:--</div>
  </div>
</header>

<script is:inline>
  // Načtení jména a nástroje
  const nameEl = document.getElementById('header-user-name');
  const roleEl = document.getElementById('header-user-role');
  const jmeno = sessionStorage.getItem('uzivatelJmeno');
  const nastroj = sessionStorage.getItem('uzivatelNastroj');

  if (nameEl && jmeno) nameEl.textContent = jmeno;
  if (roleEl && nastroj) roleEl.textContent = `(${nastroj})`;

  // Fullscreen logika
  const btn = document.getElementById('fullscreen-btn');
  const led = document.querySelector('.led');
  btn?.addEventListener('click', () => {
    !document.fullscreenElement ? document.documentElement.requestFullscreen() : document.exitFullscreen();
  });
  document.addEventListener('fullscreenchange', () => {
    document.fullscreenElement ? led?.classList.add('active') : led?.classList.remove('active');
  });

  // Hodiny a datum
  function updateClock() {
    const now = new Date();
    document.getElementById('header-date').textContent = now.toLocaleDateString('cs-CZ');
    document.getElementById('header-time').textContent = now.toLocaleTimeString('cs-CZ', { hour: '2-digit', minute: '2-digit' });
  }
  setInterval(updateClock, 1000);
  updateClock();
</script>

<style>
  .rack-header {
    background: linear-gradient(180deg, #555558 0%, #222224 45%, #111112 100%);
    border-bottom: 4px solid #000;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    padding: 10px;
    gap: 10px;
    min-height: 60px;
  }

  /* Společné boxy - sjednocený margin na 0, aby je řídil gap v headeru */
  .band-name, .user-display, .rack-btn-logout, .rack-btn-fs, .clock-box {
    height: 34px;
    display: flex;
    align-items: center;
    padding: 0 15px;
    white-space: nowrap;
    font-size: 15px;
    margin: 0; 
  }

  /* Boxy (statické) */
  .band-name, .user-display, .clock-box {
    background: #000;
    border: 1px solid #222;
    border-radius: 4px;
  }

  /* Tlačítka (interaktivní) - styl Drawer */
  .rack-btn-logout, .rack-btn-fs {
    justify-content: center;
    font-family: 'Orbitron', sans-serif;
    font-size: 14px;
    cursor: pointer;
    border-radius: 4px;
    border: 1px solid #000;
    background: linear-gradient(180deg, #3a3a3a 0%, #1c1c1c 60%, #111 100%);
    box-shadow: 0 3px 0 #000, 0 5px 10px rgba(0,0,0,0.5);
    position: relative;
    top: 0;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  /* Hover efekty - sjednocené rozsvícení */
  .rack-btn-logout:hover, .rack-btn-fs:hover {
    background: linear-gradient(180deg, #1c1c1c 0%, #3a3a3a 50%, #1c1c1c 100%);
  }

  /* Logout: tmavě červená -> světle červená + glow */
  .rack-btn-logout { color: #800; }
  .rack-btn-logout:hover { color: #f55; text-shadow: 0 0 8px #f55; }

  /* Fullscreen: šedá -> bílá + glow */
  .rack-btn-fs { color: #888; gap: 8px; }
  .rack-btn-fs:hover { color: #fff; text-shadow: 0 0 8px #fff; }

  /* Aktivní stav (stisknutí) */
  .rack-btn-logout:active, .rack-btn-fs:active {
    top: 2px;
    box-shadow: 0 1px 0 #000, inset 0 2px 5px rgba(0,0,0,0.7);
  }

  /* Specifické fonty a barvy */
  .band-name, .clock-box { font-family: 'Orbitron', sans-serif; }
  .user-display { font-family: 'Rajdhani', sans-serif; font-weight: 600; }
  .user-role { margin-left: 6px; color: #aaa; }
  .clock-box { color: #058c8a; font-weight: bold; }
  
  /* LED kontrolka */
  .led { width: 8px; height: 8px; background: #300; border-radius: 50%; }
  .led.active { background: #5f5; box-shadow: 0 0 10px #5f5; }

  /* Rozmístění hodin */
  .right-section {
    display: flex;
    gap: 10px;
    margin-left: auto;
  }

  @media (max-width: 768px) {
    .right-section { margin-left: 0; }
  }
</style>