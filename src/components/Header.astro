---
/* src/components/Header.astro */
---
<header class="rack-header">
  
  <div class="user-display-wrapper">
    <div class="user-display">
      <div class="user-info">
        <span class="user-char">PETR MAIŠAIDR</span>
        <span class="user-char-instrument">(KYTARA)</span>
      </div>
      <button id="header-logout-btn" class="rack-logout-btn" title="Odhlásit se">LOGOUT</button>
    </div>
  </div>

  <div class="controls">
    <button id="fullscreen-btn" class="rack-button" title="Fullscreen Režim">
      <span class="led"></span>
      <span class="label">FULLSCREEN</span>
    </button>
  </div>

  <div class="clock-display-wrapper">
    <div class="clock-display">
      <div id="header-date" class="clock-container date-hide-mobile"></div>
      <div class="clock-dot-separator date-hide-mobile">:</div>
      <div id="header-time" class="clock-container"></div>
    </div>
  </div>
</header>

<script>
  // Fullscreen logika
  const btn = document.getElementById('fullscreen-btn');
  btn?.addEventListener('click', () => {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(err => console.error(err));
    } else {
      document.exitFullscreen();
    }
  });

  // Logout logika (napojení na tvůj stávající logout systém)
  const logoutBtn = document.getElementById('header-logout-btn');
  logoutBtn?.addEventListener('click', () => {
    // Tady se spustí tvá funkce odhlášení, např:
    // window.location.href = '/login';
    console.log('Odhlášeno');
  });

  function updateClock() {
    const now = new Date();
    const dateEl = document.getElementById('header-date');
    const timeEl = document.getElementById('header-time');

    const createFixedChars = (str) => {
      return str.split('').map(char => {
        let type = 'num';
        let specific = '';
        if (char === '.') { type = 'sep'; specific = 'dot'; }
        else if (char === ':') { type = 'sep'; specific = 'colon'; }
        return `<span class="char ${type} ${specific}">${char}</span>`;
      }).join('');
    };

    if (dateEl) {
      const d = String(now.getDate()).padStart(2, '0');
      const m = String(now.getMonth() + 1).padStart(2, '0');
      const y = now.getFullYear();
      dateEl.innerHTML = createFixedChars(`${d}.${m}.${y}`);
    }
    if (timeEl) {
      const timeStr = now.toLocaleTimeString('cs-CZ', {
        hour: '2-digit', minute: '2-digit' // Na mobilu stačí hodiny:minuty pro úsporu místa
      });
      timeEl.innerHTML = createFixedChars(timeStr);
    }
  }

  updateClock();
  setInterval(updateClock, 1000);

  document.addEventListener('fullscreenchange', () => {
    const led = document.querySelector('.led');
    document.fullscreenElement ? led?.classList.add('active') : led?.classList.remove('active');
  });
</script>

<style>
  @font-face {
    font-family: 'Segment7';
    src: url('/fonts/LED_Dot-Matrix.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
  }

  .rack-header {
    height: var(--header-height, 60px);
    background: linear-gradient(180deg, #555558 0%, #222224 45%, #111112 100%);
    border-bottom: 4px solid #000000;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 20px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.9);
    position: relative;
    z-index: 100;
    width: 100%;
    box-sizing: border-box;
  }

  .user-display-wrapper { justify-self: start; }
  .controls { justify-self: center; }
  .clock-display-wrapper { justify-self: end; }

  .user-display, .clock-display {
    background: #000;
    height: 34px;
    box-sizing: border-box;
    border-radius: 4px;
    border: 1px solid #222;
    box-shadow: inset 0 0 15px rgba(0,0,0,1);
    display: flex;
    align-items: center;
    padding: 0px 12px;
  }

  .user-display {
    width: 290px;
    color: #08d1ce;
    font-family: 'Segment7', monospace;
    font-size: 13px;
    text-shadow: 0 0 8px rgba(8, 209, 206, 0.5);
    justify-content: space-between;
  }

  .user-info {
    display: flex;
    gap: 6px;
  }

  .user-char { text-transform: uppercase; letter-spacing: 0.5px; }
  .user-char-instrument { text-transform: uppercase; color: #04908e; }

  /* 🛠️ INTEGRACE LOGOUT TLAČÍTKA */
  .rack-logout-btn {
    background: #200;
    border: 1px solid #511;
    color: #f55;
    font-family: 'Orbitron', sans-serif;
    font-size: 9px;
    padding: 2px 6px;
    border-radius: 3px;
    cursor: pointer;
    text-shadow: 0 0 5px rgba(255,0,0,0.5);
    transition: all 0.2s;
  }
  .rack-logout-btn:hover {
    background: #500;
    color: #fff;
  }

  .clock-display {
    width: 180px;
    color: #08d1ce;
    font-family: 'Segment7', monospace;
    font-size: 13px;
    text-shadow: 0 0 8px rgba(8, 209, 206, 0.5);
    justify-content: center;
    gap: 8px;
  }

  .clock-container { display: flex; align-items: center; }
  .clock-dot-separator { opacity: 0.3; font-size: 11px; }

  /* HARDWAROVÉ ZNAKY */
  :global(.char.num) { display: inline-block; width: 9px; text-align: center; }
  :global(.char.sep) { display: inline-block; position: relative; opacity: 0.8; }
  :global(.char.colon) { width: 5px; text-align: center; }
  :global(.char.dot) { width: 3px; text-align: left; }

  /* FULLSCREEN BUTTON */
  .rack-button {
    background: #222;
    border: 1px solid #444;
    border-bottom: 3px solid #000;
    color: #888;
    padding: 6px 12px;
    border-radius: 4px;
    font-family: 'Orbitron', sans-serif;
    font-size: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .led { width: 8px; height: 8px; background: rgb(100, 20, 20); border-radius: 50%; }
  .led.active { background: rgb(81, 237, 73); box-shadow: 0 0 10px rgb(81, 237, 73); }

  /* 🛠️ ULTRA KOMPAKTNÍ MOBILNÍ ZOBRAZENÍ (VŠE NA JEDNOM ŘÁDKU) */
  @media (max-width: 768px) {
    .rack-header {
      grid-template-columns: 1fr auto; /* Jen jméno a čas, fullscreen mizí */
      padding: 0 10px;
      height: 44px; /* Krásně nízký header */
    }
    .controls {
      display: none; /* Schováme nefunkční fullscreen na mobilu */
    }
    .user-display-wrapper, .clock-display-wrapper {
      justify-self: stretch;
    }
    .user-display {
      width: auto;
      background: transparent;
      border: none;
      box-shadow: none;
      padding: 0;
    }
    .clock-display {
      width: auto;
      background: transparent;
      border: none;
      box-shadow: none;
      padding: 0;
      justify-content: flex-end;
    }
    .date-hide-mobile {
      display: none !important; /* Na mobilu schováme datum, necháme jen čas, ať to nezabírá šířku */
    }
    .user-char-instrument {
      display: none; /* Na mobilu schováme nástroj, stačí jméno a logout */
    }
  }
</style>