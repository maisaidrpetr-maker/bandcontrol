---
/* src/components/Header.astro */
---
<header class="rack-header">
  
  <div class="user-display-wrapper">
    <div class="user-display">
      <div class="user-info">
        <span class="user-char">PETR MAIŠAIDR</span>
      </div>
      <a href="/api/auth/logout" class="rack-logout-btn">LOGOUT</a>
    </div>
  </div>

  <div class="controls">
    <button id="fullscreen-btn" class="rack-button" title="Přepnout Fullscreen">
      <span class="led"></span>
      <span class="label">FULLSCREEN</span>
    </button>
  </div>

  <div class="clock-display-wrapper">
    <div class="clock-display">
      <div id="header-date" class="clock-container date-hide-mobile"></div>
      <div class="clock-dot-separator date-hide-mobile">:</div>
      <div id="header-time" class="clock-container"></div>
    </div>
  </div>
</header>

<script>
  // Fullscreen Engine
  const btn = document.getElementById('fullscreen-btn');
  btn?.addEventListener('click', () => {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(err => {
        console.log("iOS/Safari nepodporuje celoobrazovkové API přes JS:", err);
      });
    } else {
      document.exitFullscreen();
    }
  });

  // Hodiny a digitální znaky
  function updateClock() {
    const now = new Date();
    const dateEl = document.getElementById('header-date');
    const timeEl = document.getElementById('header-time');

    const createFixedChars = (str) => {
      return str.split('').map(char => {
        let type = 'num';
        let specific = '';
        if (char === '.') { type = 'sep'; specific = 'dot'; }
        else if (char === ':') { type = 'sep'; specific = 'colon'; }
        return `<span class="char ${type} ${specific}">${char}</span>`;
      }).join('');
    };

    if (dateEl) {
      const d = String(now.getDate()).padStart(2, '0');
      const m = String(now.getMonth() + 1).padStart(2, '0');
      const y = now.getFullYear();
      dateEl.innerHTML = createFixedChars(`${d}.${m}.${y}`);
    }
    if (timeEl) {
      const timeStr = now.toLocaleTimeString('cs-CZ', { hour: '2-digit', minute: '2-digit' });
      timeEl.innerHTML = createFixedChars(timeStr);
    }
  }

  updateClock();
  setInterval(updateClock, 1000);

  document.addEventListener('fullscreenchange', () => {
    const led = document.querySelector('.led');
    document.fullscreenElement ? led?.classList.add('active') : led?.classList.remove('active');
  });
</script>

<style>
  .rack-header {
    height: 60px;
    background: linear-gradient(180deg, #555558 0%, #222224 45%, #111112 100%);
    border-bottom: 4px solid #000000;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 20px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.9);
    position: relative;
    z-index: 100;
    width: 100%;
    box-sizing: border-box;
  }

  .user-display-wrapper { justify-self: start; }
  .controls { justify-self: center; }
  .clock-display-wrapper { justify-self: end; }

  .user-display, .clock-display {
    background: #000;
    height: 34px;
    box-sizing: border-box;
    border-radius: 4px;
    border: 1px solid #222;
    box-shadow: inset 0 0 15px rgba(0,0,0,1);
    display: flex;
    align-items: center;
    padding: 0 12px;
  }

  .user-display {
    width: 260px;
    color: #08d1ce;
    font-family: 'Orbitron', sans-serif; /* Použití čistého high-tech fontu pro bezchybnou českou diakritiku */
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-shadow: 0 0 8px rgba(8, 209, 206, 0.5);
    justify-content: space-between;
  }

  .rack-logout-btn {
    background: #200;
    border: 1px solid #511;
    color: #f55;
    font-family: 'Orbitron', sans-serif;
    font-size: 9px;
    padding: 3px 8px;
    border-radius: 3px;
    text-decoration: none;
    cursor: pointer;
    text-shadow: 0 0 5px rgba(255,0,0,0.5);
    transition: all 0.2s;
  }
  .rack-logout-btn:hover { background: #500; color: #fff; }

  .clock-display {
    width: 150px;
    color: #08d1ce;
    font-family: monospace;
    font-size: 14px;
    text-shadow: 0 0 8px rgba(8, 209, 206, 0.5);
    justify-content: center;
    gap: 4px;
  }

  .clock-container { display: flex; align-items: center; }
  .clock-dot-separator { opacity: 0.5; }

  /* FULLSCREEN */
  .rack-button {
    background: #222;
    border: 1px solid #444;
    border-bottom: 3px solid #000;
    color: #888;
    padding: 6px 12px;
    border-radius: 4px;
    font-family: 'Orbitron', sans-serif;
    font-size: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .led { width: 8px; height: 8px; background: rgb(100, 20, 20); border-radius: 50%; }
  .led.active { background: rgb(81, 237, 73); box-shadow: 0 0 10px rgb(81, 237, 73); }

  /* RESPONSIVITA PRO MOBIL */
  @media (max-width: 768px) {
    .rack-header {
      grid-template-columns: auto 1fr auto;
      padding: 0 8px;
      height: 52px;
    }
    .user-display { width: 145px; font-size: 9px; padding: 0 6px; }
    .rack-logout-btn { padding: 2px 4px; font-size: 8px; }
    .clock-display { width: 65px; background: transparent; border: none; box-shadow: none; }
    .date-hide-mobile { display: none !important; }
    .rack-button .label { display: none; } /* Ušetříme místo, na mobilu zůstane u Fullscreenu jen stylová LEDka */
    .rack-button { padding: 8px; }
  }
</style>