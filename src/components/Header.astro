<header class="rack-header">
  
  <div class="band-name-wrapper">
    <div class="band-name">BLUE HEART</div>
  </div>

  <div class="user-display-wrapper">
    <div class="user-display">
      <div class="user-info-row">
        <span id="header-user-name" class="user-char">---</span>
        <span class="user-role">(KYTARA)</span>
      </div>
      <a href="#" id="logout-btn" class="rack-logout-btn">LOGOUT</a>
    </div>
  </div>

  <div class="controls">
    <button id="fullscreen-btn" class="rack-button" title="Přepnout Fullscreen">
      <span class="led"></span>
      <span class="label">FULLSCREEN</span>
    </button>
  </div>

  <div class="clock-display-wrapper">
    <div class="clock-display">
      <div id="header-date" class="clock-container date-hide-mobile"></div>
      <div class="clock-dot-separator date-hide-mobile">:</div>
      <div id="header-time" class="clock-container"></div>
    </div>
  </div>
</header>

<script>
  const userNameEl = document.getElementById('header-user-name');
  const savedName = sessionStorage.getItem('uzivatelJmeno');
  if (savedName) {
    userNameEl.textContent = savedName.split('(')[0].trim().toUpperCase();
  }

  const btn = document.getElementById('fullscreen-btn');
  const led = document.querySelector('.led');
  btn?.addEventListener('click', () => {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(err => console.log(err));
    } else {
      document.exitFullscreen();
    }
  });

  function updateClock() {
    const now = new Date();
    const dateEl = document.getElementById('header-date');
    const timeEl = document.getElementById('header-time');

    const createFixedChars = (str) => {
      return str.split('').map(char => {
        let type = 'num';
        let specific = '';
        if (char === '.') { type = 'sep'; specific = 'dot'; }
        else if (char === ':') { type = 'sep'; specific = 'colon'; }
        return `<span class="char ${type} ${specific}">${char}</span>`;
      }).join('');
    };

    if (dateEl) {
      const d = String(now.getDate()).padStart(2, '0');
      const m = String(now.getMonth() + 1).padStart(2, '0');
      const y = now.getFullYear();
      dateEl.innerHTML = createFixedChars(`${d}.${m}.${y}`);
    }
    if (timeEl) {
      const timeStr = now.toLocaleTimeString('cs-CZ', { hour: '2-digit', minute: '2-digit' });
      timeEl.innerHTML = createFixedChars(timeStr);
    }
  }

  updateClock();
  setInterval(updateClock, 1000);

  document.addEventListener('fullscreenchange', () => {
    document.fullscreenElement ? led?.classList.add('active') : led?.classList.remove('active');
  });
</script>

<style>
  .rack-header {
    height: 60px;
    background: linear-gradient(180deg, #555558 0%, #222224 45%, #111112 100%);
    border-bottom: 4px solid #000;
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 0 15px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.9);
    width: 100%;
    box-sizing: border-box;
  }

  .band-name, .user-display, .clock-display {
    background: #000;
    height: 34px;
    box-sizing: border-box;
    border-radius: 4px;
    border: 1px solid #222;
    box-shadow: inset 0 0 15px rgba(0,0,0,1);
    display: flex;
    align-items: center;
    color: #08d1ce;
    font-family: 'Orbitron', sans-serif;
  }

  .band-name { padding: 0 15px; font-size: 12px; font-weight: bold; letter-spacing: 2px; }
  
  .user-display {
    width: 320px;
    padding: 0 12px;
    justify-content: space-between;
  }
  
  .user-info-row { 
    display: flex; 
    align-items: center; 
    gap: 8px; 
    white-space: nowrap; 
    overflow: hidden;
  }
  
  .user-char { font-size: 11px; font-weight: 700; }
  .user-role { font-size: 10px; color: #888; }

  .rack-logout-btn {
    background: #200;
    border: 1px solid #511;
    color: #f55;
    font-size: 9px;
    padding: 3px 8px;
    border-radius: 3px;
    text-decoration: none;
    cursor: pointer;
  }
  .rack-logout-btn:hover { background: #500; color: #fff; }

  .clock-display { padding: 0 20px; font-size: 14px; justify-content: center; gap: 4px; }

  .rack-button {
    background: #222;
    border: 1px solid #444;
    border-bottom: 3px solid #000;
    color: #888;
    padding: 6px 12px;
    border-radius: 4px;
    font-family: 'Orbitron', sans-serif;
    font-size: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .led { width: 8px; height: 8px; background: rgb(100, 20, 20); border-radius: 50%; }
  .led.active { background: rgb(81, 237, 73); box-shadow: 0 0 10px rgb(81, 237, 73); }

  <style>
  /* Původní styly zůstávají, jen upravíme tento media query blok */
  @media (max-width: 768px) {
    .rack-header { 
      grid-template-columns: repeat(2, 1fr); /* 2 sloupce místo 4 */
      padding: 5px;
      height: auto; /* necháme header růst podle potřeby */
      gap: 5px;
    }
    
    .band-name-wrapper { order: 1; }
    .controls { order: 2; }
    .user-display-wrapper { order: 3; grid-column: span 2; width: 100%; }
    
    .user-display { 
      width: 100% !important; /* plná šířka na mobilu */
      justify-content: space-between;
    }
    
    .clock-display-wrapper { display: none; } /* na iPhonu čas skrýváme */
  }
</style>
</style>