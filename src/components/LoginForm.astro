---
// src/components/LoginForm.astro
export interface Props {
  errorMessage?: string;
}

const { errorMessage } = Astro.props;
---

<div class="login-form-wrapper">
  <form method="POST" autocomplete="off">
    <input 
      type="password" 
      name="password" 
      placeholder="ZADEJTE HESLO" 
      required 
      autofocus 
      class={errorMessage ? 'input-error' : ''}
    />
    <button type="submit">OVĚŘIT</button>
  </form>
</div>

<style>
  .login-form-wrapper {
    position: relative;
    z-index: 4;
    width: 100%;
    max-width: 300px;
    margin-top: -20px;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  input[type="password"] {
    width: 100%;
    padding: 10px 15px;
    background: rgba(20, 20, 20, 0.8);
    border: 1px solid #ff0000;
    border-radius: 4px;
    color: #fff;
    font-family: 'Courier New', monospace;
    font-size: 16px;
    text-align: center;
    letter-spacing: 3px;
    outline: none;
    box-shadow: 0 0 10px rgba(255, 0, 0, 0.2);
    transition: all 0.3s ease;
  }

  input[type="password"]:focus {
    box-shadow: 0 0 15px rgba(255, 0, 0, 0.6);
    background: rgba(30, 10, 10, 0.9);
  }

  /* Vizuální zpětná vazba při chybě */
  input.input-error {
    border-color: #ff3333;
    background: rgba(50, 10, 10, 0.9);
    animation: shake 0.2s ease-in-out 2;
  }

  button {
    padding: 10px;
    background: #ff0000;
    color: #000;
    border: none;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-weight: bold;
    font-size: 16px;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  button:hover {
    background: #fff;
    box-shadow: 0 0 15px #fff;
  }

  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-4px); }
    75% { transform: translateX(4px); }
  }
</style>