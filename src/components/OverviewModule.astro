---
/* src/components/OverviewModule.astro */
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

// 1. Načtení textů písniček (Songs) ze src/content/songs
const songs = await getCollection('songs');
const songsCount = songs.length;

// 2. Načtení zápisů ze zkoušek (Activities) ze src/content/activities
const activities = await getCollection('activities');
const activitiesCount = activities.length;

// 3. Počet MP3 souborů v /public/audio
// V Astro projektu ukazuje process.cwd() na kořen projektu, což funguje skvěle při buildu
const audioDir = path.join(process.cwd(), 'public', 'audio');
let mp3Count = 0;

try {
  if (fs.existsSync(audioDir)) {
    const files = fs.readdirSync(audioDir);
    // Počítáme jen .mp3 soubory, ignorujeme případné systémové soubory
    mp3Count = files.filter(file => file.toLowerCase().endsWith('.mp3')).length;
  }
} catch (err) {
  // Pokud složka neexistuje (např. při prvním spuštění), necháme 0
  console.warn("Audio directory not found, defaulting to 0.");
}

const stats = [
  { label: "Lyrics (.md)", value: songsCount },
  { label: "Audio (.mp3)", value: mp3Count },
  { label: "Session Logs (.md)", value: activitiesCount }
];
---

<div class="sidebar-v-unit">
  <div class="v-plate">
    <div class="engraved-label">Overview</div>
    
    <div class="v-window">
      <div class="overview-content">
        {stats.map(stat => (
          <div class="stat-row">
            <span class="stat-label">{stat.label}</span>
            <span class="stat-value">{stat.value}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="rivet t-l"></div>
    <div class="rivet t-r"></div>
  </div>
</div>

<style>
  .sidebar-v-unit {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 0px 0;
  }

  .v-plate {
    width: 100%;
    height: 160px;
    background: linear-gradient(135deg, #2c2c2c 0%, #484848 25%, #1a1a1a 50%, #424242 75%, #222222 100%);
    border: 1px solid #000;
    border-radius: 12px;
    position: relative;
    padding: 48px 12px 14px 12px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    box-shadow: 
      0px 4px 10px rgba(0, 0, 0, 0.8),
      inset 0px 1px 0px rgba(255, 255, 255, 0.45),
      inset 0px -2px 3px rgba(0, 0, 0, 0.6);
  }

  .engraved-label {
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    text-align: center;
    color: #b87333;
    font-family: sans-serif;
    font-size: 1.5rem;
    font-weight: 550;
    letter-spacing: 0.5px;
    text-shadow: 
      0px 1px 1px rgba(255, 255, 255, 0.25),
      0px -1px 2px rgba(0, 0, 0, 0.9);
  }

  .v-window {
    width: 100%;
    flex: 1;
    background: #000;
    border-radius: 9px;
    display: flex;
    align-items: center;
    box-shadow: 
      inset 6px 6px 15px rgba(0, 0, 0, 1),
      0px 2px 0px rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(0, 0, 0, 0.9);
    overflow: hidden;
  }

  .overview-content {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .stat-row {
    display: flex;
    justify-content: space-between;
    padding: 0px 20px;
    font-family: sans-serif;
    height: 22px;
    align-items: center;
  }

  .stat-label {
    color: #b87333;
    font-size: 1.1rem;
  }

  .stat-value {
    color: #e0e0e0; /* Naše sjednocená jemně bílá */
    font-size: 1.2rem;
    font-weight: bold;
    white-space: nowrap;
  }

  .rivet {
    position: absolute;
    width: 9px;
    height: 9px;
    background: radial-gradient(circle at 35% 35%, #ffffff 0%, #aaaaaa 20%, #222222 80%, #000000 100%);
    box-shadow: 1px 2px 3px rgba(0,0,0,0.8);
    border-radius: 50%;
  }

  .t-l { top: 12px; left: 12px; }
  .t-r { top: 12px; right: 12px; }
</style>