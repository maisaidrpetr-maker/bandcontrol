---
/* src/components/PlaylistModule.astro */
---

<div class="sidebar-v-unit">
  <div class="v-plate">
    <div class="engraved-label">Playlists</div>
    
    <div class="v-window">
      <!-- Prázdné okno -->
    </div>

    <div class="rivet t-l"></div>
    <div class="rivet t-r"></div>
  </div>
</div>

<style>
  .sidebar-v-unit { display: flex; justify-content: center; width: 100%; }
  
  .v-plate {
    width: 95%; max-width: 280px; margin: 0 auto;
    height: fit-content;
    background: linear-gradient(135deg, #2c2c2c 0%, #484848 25%, #1a1a1a 50%, #424242 75%, #222222 100%);
    border: 1px solid #000; border-radius: 12px;
    position: relative; padding: 50px 12px 14px 12px;
    display: flex; flex-direction: column;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.8), inset 0px 1px 0px rgba(255, 255, 255, 0.45), inset 0px -2px 3px rgba(0, 0, 0, 0.6);
  }

  .engraved-label { position: absolute; top: 12px; left: 0; right: 0; text-align: center; color: #b87333; font-family: sans-serif; font-size: 1.5rem; font-weight: 550; text-shadow: 0px 1px 1px rgba(255, 255, 255, 0.25), 0px -1px 2px rgba(0, 0, 0, 0.9); }
  
  .v-window { 
    width: 100%; min-height: 150px; /* Nastavil jsem minimální výšku, aby okno nebylo úplně neviditelné */
    background: #000; border-radius: 9px; 
    border: 1px solid rgba(0, 0, 0, 0.9); 
    box-shadow: inset 6px 6px 15px rgba(0, 0, 0, 1), 0px 2px 0px rgba(255, 255, 255, 0.2); 
    padding: 6px 0; 
  }
  
  .rivet { position: absolute; width: 9px; height: 9px; background: radial-gradient(circle at 35% 35%, #fff 0%, #222 100%); border-radius: 50%; }
  .t-l { top: 12px; left: 12px; } .t-r { top: 12px; right: 12px; }
</style>