---
// src/components/SplashScreen.astro
---

<div class="splash-screen" id="global-splash-wrapper">
  <div class="logo-container">
    <div class="text-group">
      <h1>BandControl</h1>
      <svg class="line-svg" viewBox="0 0 400 30">
        <path class="animated-line" d="M0 15 L 175 15 Q 200 5, 225 15 L 400 15" />
      </svg>
      <p class="sub-title">Band Management System</p>
    </div>

    <div class="chip-interface">
      <input type="password" id="password-input" placeholder="ACCESS KEY" />
      <button id="submit-btn">RUN</button>
    </div>
  </div>
</div>

<style>
  .splash-screen {
    position: fixed; inset: 0; background: #121212;
    display: flex; justify-content: center; align-items: center;
    z-index: 9999;
  }

  .text-group { text-align: center; }
  
  h1 { color: #fff; font-size: 3rem; margin: 0; }
  .sub-title { color: #666; font-size: 1rem; opacity: 0; animation: fadeIn 0.5s 2.5s forwards; }

  /* Animace linky */
  .line-svg { width: 300px; height: 30px; stroke: #ff4d4d; stroke-width: 2; fill: none; }
  .animated-line {
    stroke-dasharray: 400; stroke-dashoffset: 400;
    animation: drawLine 2s linear forwards;
  }

  @keyframes drawLine {
    to { stroke-dashoffset: 0; stroke: #4dff88; }
  }

  /* Glow efekt uprostřed */
  .animated-line::after { /* Pro zjednodušení použito CSS na vlnku */ }

  .chip-interface { opacity: 0; animation: fadeIn 0.5s 3s forwards; margin-top: 20px; }
  @keyframes fadeIn { to { opacity: 1; } }
</style>