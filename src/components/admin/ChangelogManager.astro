---
import { execSync } from 'child_process';

let commits: Array<{ hash: string; author: string; date: string; message: string }> = [];

try {
  // Vytažení kompletní historie bez omezení počtu
  const gitLog = execSync('git log --pretty=format:"%h|%an|%ad|%s" --date=short', { encoding: 'utf-8' });
  
  commits = gitLog.split('\n').filter(Boolean).map(line => {
    const [hash, author, date, message] = line.split('|');
    return { hash, author, date, message };
  });
} catch (e) {
  commits = [];
}
---

<header class="panel-header">
  <h1>CHANGELOG</h1>
</header>

<div class="column">
  <h2>Kompletní historie změn a verzí z gitu</h2>
  <div class="changelog-list" style="margin-top: 15px; display: flex; flex-direction: column; gap: 10px;">
    {commits.length > 0 ? (
      commits.map((commit) => (
        <div class="commit-card" style="background: #1c1c1c; border: 1px solid #333; padding: 12px 16px; border-radius: 6px; display: flex; justify-content: space-between; align-items: center;">
          <div>
            <div style="font-weight: bold; color: #ff8800; font-size: 1rem; margin-bottom: 4px;">
              {commit.message}
            </div>
            <div style="font-size: 0.85rem; color: #888;">
              Autor: {commit.author}
            </div>
          </div>
          <div style="text-align: right; font-size: 0.85rem; color: #aaa; font-family: monospace;">
            <span style="background: #2a2a2a; padding: 2px 6px; border-radius: 4px; border: 1px solid #444; color: #ff8800;">{commit.hash}</span>
            <div style="margin-top: 4px;">📅 {commit.date}</div>
          </div>
        </div>
      ))
    ) : (
      <div class="empty" style="color: #666; font-style: italic; text-align: center; margin-top: 40px;">Žádná historie commitů nenalezena.</div>
    )}
  </div>
</div>