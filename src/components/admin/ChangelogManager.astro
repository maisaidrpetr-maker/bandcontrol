---
import { execSync } from 'child_process';

interface Commit {
  hash: string;
  author: string;
  date: string;
  message: string;
}

let commits: Commit[] = [];

try {
  const gitLog = execSync('git log --pretty=format:"%h|%an|%ad|%s" --date=short', { encoding: 'utf-8' });
  commits = gitLog.split('\n').filter(Boolean).map(line => {
    const [hash, author, date, message] = line.split('|');
    return { hash, author, date, message };
  });
} catch (e) {
  // Lokální git selhal
}

if (commits.length === 0) {
  try {
    const response = await fetch('https://api.github.com/repos/maisaidrpetr-maker/bandcontrol/commits');
    if (response.ok) {
      const apiCommits = await response.json();
      commits = apiCommits.map((c: any) => ({
        hash: c.sha.substring(0, 7),
        author: c.commit.author.name,
        date: c.commit.author.date.split('T')[0],
        message: c.commit.message
      }));
    }
  } catch (apiError) {
    console.error('Nepodařilo se načíst commity:', apiError);
  }
}
---

<header class="panel-header">
  <h1>CHANGELOG</h1>
</header>

<div class="column" id="changelog-container" data-commits={JSON.stringify(commits)}>
  <h2>Kompletní historie změn a verzí</h2>
  
  <!-- Seznam commitů - jeden úzký řádek -->
  <div id="changelog-list" style="margin-top: 10px; display: flex; flex-direction: column; gap: 4px;">
    <!-- Vygeneruje se dynamicky přes JS, aby fungovalo stránkování -->
  </div>

  <!-- Spodní lišta stránkování -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px; padding: 6px 12px; background: #161616; border: 1px solid #333; border-radius: 4px;">
    <div style="display: flex; gap: 6px;">
      <button id="prev-page" style="background: #222; border: 1px solid #444; color: #aaa; padding: 3px 8px; border-radius: 3px; cursor: pointer; font-weight: bold;">◄</button>
      <button id="next-page" style="background: #2a2a2a; border: 1px solid #555; color: #fff; padding: 3px 8px; border-radius: 3px; cursor: pointer; font-weight: bold;">►</button>
    </div>
    <div id="page-info" style="font-size: 0.8rem; color: #888; font-family: sans-serif;">
      Stránka 1 z 1
    </div>
  </div>
</div>

<script>
  const container = document.getElementById('changelog-container');
  if (container) {
    const commits = JSON.parse(container.getAttribute('data-commits') || '[]');
    const itemsPerPage = 10;
    let currentPage = 1;
    const totalPages = Math.ceil(commits.length / itemsPerPage) || 1;

    const listEl = document.getElementById('changelog-list');
    const infoEl = document.getElementById('page-info');
    const prevBtn = document.getElementById('prev-page');
    const nextBtn = document.getElementById('next-page');

    function renderPage() {
      if (!listEl) return;
      
      const start = (currentPage - 1) * itemsPerPage;
      const end = start + itemsPerPage;
      const pageCommits = commits.slice(start, end);

      if (pageCommits.length === 0) {
        listEl.innerHTML = '<div style="color: #666; font-style: italic; text-align: center; margin-top: 20px;">Žádná historie commitů nenalezena.</div>';
        return;
      }

      listEl.innerHTML = pageCommits.map(commit => `
        <div style="background: #1c1c1c; border: 1px solid #333; padding: 5px 10px; border-radius: 4px; display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
          <div style="display: flex; align-items: center; gap: 12px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; flex-grow: 1; margin-right: 15px;">
            <span style="font-weight: 600; color: #ff8800;">${commit.message}</span>
            <span style="color: #666; font-size: 0.75rem;">(${commit.author})</span>
          </div>
          <div style="text-align: right; font-size: 0.75rem; color: #aaa; font-family: monospace; display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
            <span style="background: #2a2a2a; padding: 1px 4px; border-radius: 3px; border: 1px solid #444; color: #ff8800;">${commit.hash}</span>
            <span>📅 ${commit.date}</span>
          </div>
        </div>
      `).join('');

      if (infoEl) infoEl.textContent = `Stránka ${currentPage} z ${totalPages}`;
      if (prevBtn) (prevBtn as HTMLButtonElement).style.opacity = currentPage === 1 ? '0.4' : '1';
      if (nextBtn) (nextBtn as HTMLButtonElement).style.opacity = currentPage === totalPages ? '0.4' : '1';
    }

    prevBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        renderPage();
      }
    });

    nextBtn?.addEventListener('click', () => {
      if (currentPage < totalPages) {
        currentPage++;
        renderPage();
      }
    });

    renderPage();
  }
</script>