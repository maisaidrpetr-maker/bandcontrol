---
// src/components/admin/EventManager.astro
---

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
  <h2 style="color: #ff8800; font-size: 1.1rem; letter-spacing: 0.5px; margin: 0;">SPRÁVA UDÁLOSTÍ A KONCERTŮ</h2>
  <button type="button" onclick="openEventModal()" style="background: linear-gradient(180deg, #ff8800 0%, #cc6a00 100%); border: none; color: #fff; padding: 6px 14px; border-radius: 4px; cursor: pointer; font-size: 0.75rem; font-weight: bold;">+ Nová událost</button>
</div>

<div class="events-container">
  <p style="color: #777; text-align: center; padding: 20px;">Načítám události...</p>
</div>

<!-- Modální okno pro novou událost -->
<div id="event-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 1000; justify-content: center; align-items: center;">
  <div style="background: #141414; border: 1px solid #333; padding: 25px; border-radius: 8px; width: 100%; max-width: 450px; display: flex; flex-direction: column; gap: 15px;">
    <h3 style="color: #ff8800; margin: 0; font-size: 1rem;">Nová událost / koncert</h3>
    
    <div>
      <label style="font-size: 0.75rem; color: #888; display: block; margin-bottom: 4px;">Název akce</label>
      <input type="text" id="event-title-input" placeholder="např. Koncert v klubu" style="width: 100%; padding: 8px; background: #0a0a0a; border: 1px solid #333; color: #fff; border-radius: 4px; font-size: 0.9rem;" />
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
      <div>
        <label style="font-size: 0.75rem; color: #888; display: block; margin-bottom: 4px;">Datum</label>
        <input type="date" id="event-date-input" style="width: 100%; padding: 8px; background: #0a0a0a; border: 1px solid #333; color: #fff; border-radius: 4px; font-size: 0.9rem;" />
      </div>
      <div>
        <label style="font-size: 0.75rem; color: #888; display: block; margin-bottom: 4px;">Čas</label>
        <input type="time" id="event-time-input" style="width: 100%; padding: 8px; background: #0a0a0a; border: 1px solid #333; color: #fff; border-radius: 4px; font-size: 0.9rem;" />
      </div>
    </div>

    <div>
      <label style="font-size: 0.75rem; color: #888; display: block; margin-bottom: 4px;">Místo konání</label>
      <input type="text" id="event-location-input" placeholder="např. Rock Café, Praha" style="width: 100%; padding: 8px; background: #0a0a0a; border: 1px solid #333; color: #fff; border-radius: 4px; font-size: 0.9rem;" />
    </div>

    <div>
      <label style="font-size: 0.75rem; color: #888; display: block; margin-bottom: 4px;">Přiřazený playlist</label>
      <select id="event-playlist-select" style="width: 100%; padding: 8px; background: #0a0a0a; border: 1px solid #333; color: #fff; border-radius: 4px; font-size: 0.9rem;">
        <option value="">-- Žádný playlist --</option>
      </select>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 10px;">
      <button type="button" onclick="closeEventModal()" style="background: #222; border: 1px solid #333; color: #aaa; padding: 8px 14px; border-radius: 4px; cursor: pointer; font-size: 0.8rem;">Zrušit</button>
      <button type="button" onclick="saveNewEvent()" style="background: linear-gradient(180deg, #ff8800 0%, #cc6a00 100%); border: none; color: #fff; padding: 8px 16px; border-radius: 4px; cursor: pointer; font-size: 0.8rem; font-weight: bold;">Uložit událost</button>
    </div>
  </div>
</div>

<script is:inline>
  window.loadEvents = async function() {
    const container = document.querySelector('.events-container');
    if (!container) return;
    container.innerHTML = '<p style="color: #777; text-align: center; padding: 20px;">Načítám události...</p>';

    try {
      const res = await fetch('/api/events');
      const events = res.ok ? await res.json() : [];

      if (events.length === 0) {
        container.innerHTML = '<p style="color: #777; text-align: center; padding: 20px;">Zatím nejsou naplánované žádné události.</p>';
        return;
      }

      container.innerHTML = '<div style="display: flex; flex-direction: column; gap: 12px;">' + events.map(ev => `
        <div style="background: #111; border: 1px solid #333; padding: 15px; border-radius: 6px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
          <div>
            <strong style="color: #ff8800; font-size: 1rem; display: block; margin-bottom: 4px;">${ev.title}</strong>
            <div style="font-size: 0.8rem; color: #aaa; display: flex; gap: 15px; flex-wrap: wrap;">
              <span>📅 ${ev.date || 'Neurčeno'} ${ev.time ? 'v ' + ev.time : ''}</span>
              <span>📍 ${ev.location || 'Neznámo'}</span>
              ${ev.playlistId ? '<span style="color: #6699ff;">🎵 Playlist přiřazen</span>' : ''}
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 10px;">
            <button type="button" onclick="deleteEvent('${ev.id}')" style="background: #2a1111; border: 1px solid #552222; color: #ff6666; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 0.75rem;">Smazat</button>
          </div>
        </div>
      `).join('') + '</div>';

    } catch (err) {
      container.innerHTML = '<p style="color: #ff4444; text-align: center; padding: 20px;">Nepodařilo se načíst události.</p>';
    }
  };

  window.openEventModal = async function() {
    try {
      const res = await fetch('/api/playlists');
      const playlists = res.ok ? await res.json() : [];
      const select = document.getElementById('event-playlist-select');
      
      select.innerHTML = '<option value="">-- Žádný playlist --</option>' + playlists.map(pl => `
        <option value="${pl.id}">${pl.name} (${pl.songs.length} skladeb)</option>
      `).join('');
    } catch (err) {
      console.error('Chyba při načítání playlistů do selectu', err);
    }

    document.getElementById('event-title-input').value = '';
    document.getElementById('event-date-input').value = '';
    document.getElementById('event-time-input').value = '';
    document.getElementById('event-location-input').value = '';
    document.getElementById('event-modal').style.display = 'flex';
  };

  window.closeEventModal = function() {
    document.getElementById('event-modal').style.display = 'none';
  };

  window.saveNewEvent = async function() {
    const title = document.getElementById('event-title-input').value.trim();
    const date = document.getElementById('event-date-input').value;
    const time = document.getElementById('event-time-input').value;
    const location = document.getElementById('event-location-input').value.trim();
    const playlistId = document.getElementById('event-playlist-select').value;

    if (!title) {
      alert('Zadej název události.');
      return;
    }

    try {
      const res = await fetch('/api/events');
      const events = res.ok ? await res.json() : [];

      events.push({
        id: 'ev_' + Date.now(),
        title,
        date,
        time,
        location,
        playlistId
      });

      const saveRes = await fetch('/api/events', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(events)
      });

      if (!saveRes.ok) throw new Error('Chyba při ukládání');

      closeEventModal();
      loadEvents();
    } catch (err) {
      alert('Nepodařilo se uložit událost.');
    }
  };

  window.deleteEvent = async function(id) {
    if (!confirm('Opravdu smazat tuto událost?')) return;
    try {
      const res = await fetch('/api/events');
      const events = res.ok ? await res.json() : [];
      const filtered = events.filter(e => e.id !== id);

      await fetch('/api/events', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(filtered)
      });
      loadEvents();
    } catch (err) {
      alert('Chyba při mazání události.');
    }
  };
</script>