// src/pages/dashboard.astro
import '../styles/global.css';
import NavigationDrawer from '../components/NavigationDrawer.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { createClient } from 'redis';
import fs from 'node:fs';
import path from 'node:path';
import { execSync } from 'child_process';

// 1. Načtení písní a vytvoření mapy
const allLyrics = await getCollection('lyrics');
const lyricsMap = Object.fromEntries(
  allLyrics.map(s => {
    const data = s.data as any;
    let capoVal = data.capo;
    if (capoVal === undefined || capoVal === null || capoVal === '' || capoVal === '-' || capoVal === 0) {
      capoVal = '';
    }
    return [
      s.id, 
      {
        title: data.title || s.id,
        key: data.key || '',
        capo: capoVal,
        bpm: data.bpm || ''
      }
    ];
  })
);

// 2. Připojení k Redis pro získání aktivního playlistu
const client = createClient({
  url: import.meta.env.REDIS_URL
});

client.on('error', () => {});
await client.connect().catch(() => {});

let activePlaylist: any = null;
let allPlaylistsForList = [];
try {
  const rawPlaylists = await client.get('bandcontrol:playlists');
  const playlists = rawPlaylists ? JSON.parse(rawPlaylists) : [];
  allPlaylistsForList = playlists;

  const activeId = await client.get('bandcontrol:active_playlist') || await client.get('active_playlist');
  if (activeId) {
    activePlaylist = playlists.find((p: any) => p.id === activeId);
  }
  if (!activePlaylist && playlists.length > 0) {
    activePlaylist = playlists[0];
  }
} catch (err) {
  console.error('Chyba při načítání playlistů v dashboardu:', err);
}
await client.disconnect().catch(() => {});

// Načtení akcí z Redis API endpointu
let allEvents = [];
try {
  const response = new URL('/api/events', Astro.request.url);
  const res = await fetch(response.toString());
  if (res.ok) {
    allEvents = await res.json();
  }
} catch (e) {
  console.error('Chyba při načítání událostí:', e);
}

const now = new Date();
const todayTimestamp = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();

const processedEvents = allEvents.map((ev: any) => {
  const dateObj = new Date(ev.date + (ev.time ? `T${ev.time}` : 'T00:00:00'));
  return {
    ...ev,
    timestamp: isNaN(dateObj.getTime()) ? 0 : dateObj.getTime(),
  };
});

const futureEvents = processedEvents
  .filter(ev => ev.timestamp >= todayTimestamp)
  .sort((a, b) => b.timestamp - a.timestamp);

const pastEvents = processedEvents
  .filter(ev => ev.timestamp < todayTimestamp)
  .sort((a, b) => b.timestamp - a.timestamp);

const upcomingEvents = [
  ...futureEvents,
  ...pastEvents
];

const strictFuture = processedEvents
  .filter(ev => ev.timestamp >= todayTimestamp)
  .sort((a, b) => a.timestamp - b.timestamp);
const nextFutureId = strictFuture.length > 0 ? strictFuture[0].timestamp : null;

const songsCount = allLyrics.length;
let audioFilesCount = 0;
try {
  const audioDir = path.resolve('./public/audio');
  if (fs.existsSync(audioDir)) {
    const files = fs.readdirSync(audioDir);
    audioFilesCount = files.filter(file => file.toLowerCase().endsWith('.mp3')).length;
  }
} catch (e) {}

const allActivities = await getCollection('activities');
const sortedActivities = [...allActivities].sort((a: any, b: any) => {
  const timeA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const timeB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return timeB - timeA;
});

function formatCzechDate(dateStr) {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return dateStr;
  
  const months = [
    'ledna', 'února', 'března', 'dubna', 'května', 'června',
    'července', 'srpna', 'září', 'října', 'listopadu', 'prosince'
  ];
  
  return `${d.getDate()}. ${months[d.getMonth()]} ${d.getFullYear()}`;
}

// Získání commitů pro systémové operace (lokální git + GitHub fallback)
let commits: any[] = [];
try {
  const gitLog = execSync('git log --pretty=format:"%h|%an|%ad|%s" --date=short', { encoding: 'utf-8' });
  commits = gitLog.split('\n').filter(Boolean).map(line => {
    const [hash, author, date, message] = line.split('|');
    return { hash, author, date, message };
  });
} catch (e) {
  // Lokální git selhal
}

if (commits.length === 0) {
  try {
    const response = await fetch('https://api.github.com/repos/maisaidrpetr-maker/bandcontrol/commits');
    if (response.ok) {
      const apiCommits = await response.json();
      commits = apiCommits.map((c: any) => ({
        hash: c.sha.substring(0, 7),
        author: c.commit.author.name,
        date: c.commit.author.date.split('T')[0],
        message: c.commit.message
      }));
    }
  } catch (apiError) {
    console.error('Nepodařilo se načíst commity z GitHub API:', apiError);
  }
}

let githubLatestCommit = commits.length > 0 ? `${commits[0].hash}: ${commits[0].message}` : 'Aktualizace systému';
let githubTotalCommits = commits.length > 0 ? commits.length.toString() : '—';

// Formátování data posledního commitu na tvar xx. xx. xxxx (např. 08. 08. 2026)
let formattedCommitDate = '';
if (commits.length > 0 && commits[0].date) {
  const dObj = new Date(commits[0].date);
  if (!isNaN(dObj.getTime())) {
    const day = String(dObj.getDate()).padStart(2, '0');
    const month = String(dObj.getMonth() + 1).padStart(2, '0');
    const year = dObj.getFullYear();
    formattedCommitDate = `${day}. ${month}. ${year}`;
  } else {
    formattedCommitDate = commits[0].date;
  }
}

// Získání celkového počtu souborů projektu (lokálně / fallback GitHub API)
let githubTotalFiles = '—';
try {
  const gitFiles = execSync('git ls-files', { encoding: 'utf-8' });
  const fileCount = gitFiles.split('\n').filter(Boolean).length;
  if (fileCount > 0) {
    githubTotalFiles = fileCount.toString();
  }
} catch (e) {
  // Lokální git selhal
}

if (githubTotalFiles === '—') {
  try {
    const response = await fetch('https://api.github.com/repos/maisaidrpetr-maker/bandcontrol/git/trees/main?recursive=1');
    if (response.ok) {
      const data = await response.json();
      const files = data.tree.filter((item: any) => item.type === 'blob');
      githubTotalFiles = files.length.toString();
    }
  } catch (apiError) {
    console.error('Nepodařilo se načíst soubory z GitHub API:', apiError);
  }
}
