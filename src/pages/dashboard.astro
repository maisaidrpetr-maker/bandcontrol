---
// src/pages/dashboard.astro
import '../styles/global.css';
import NavigationDrawer from '../components/NavigationDrawer.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

// Načtení akcí z Redis API endpointu
let allEvents = [];
try {
  const response = new URL('/api/events', Astro.request.url);
  const res = await fetch(response.toString());
  if (res.ok) {
    allEvents = await res.json();
  }
} catch (e) {
  console.error('Chyba při načítání událostí:', e);
}

const now = new Date();
const todayTimestamp = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();

const processedEvents = allEvents.map((ev: any) => {
  const dateObj = new Date(ev.date + (ev.time ? `T${ev.time}` : 'T00:00:00'));
  return {
    ...ev,
    timestamp: isNaN(dateObj.getTime()) ? 0 : dateObj.getTime(),
  };
});

const futureEvents = processedEvents
  .filter(ev => ev.timestamp >= todayTimestamp)
  .sort((a, b) => b.timestamp - a.timestamp);

const pastEvents = processedEvents
  .filter(ev => ev.timestamp < todayTimestamp)
  .sort((a, b) => b.timestamp - a.timestamp);

const upcomingEvents = [
  ...futureEvents,
  ...pastEvents
];

const strictFuture = processedEvents
  .filter(ev => ev.timestamp >= todayTimestamp)
  .sort((a, b) => a.timestamp - b.timestamp);
const nextFutureId = strictFuture.length > 0 ? strictFuture[0].timestamp : null;

// Playlisty
let playlists = [];
try {
  const res = await fetch(new URL('/api/playlists', Astro.request.url).toString());
  if (res.ok) {
    playlists = await res.json();
  }
} catch (e) {}

// Písně (Lyrics)
const allLyrics = await getCollection('lyrics');
const songsCount = allLyrics.length;

// Audio soubory - načtení ze složky public/audio (.mp3)
let audioFilesCount = 0;
try {
  const audioDir = path.resolve('./public/audio');
  if (fs.existsSync(audioDir)) {
    const files = fs.readdirSync(audioDir);
    audioFilesCount = files.filter(file => file.toLowerCase().endsWith('.mp3')).length;
  }
} catch (e) {
  console.error('Chyba při načítání audio souborů:', e);
}

// Zápisy / Aktivity - seřazené od nejnovějších
const allActivities = await getCollection('activities');
const sortedActivities = [...allActivities].sort((a: any, b: any) => {
  const timeA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const timeB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return timeB - timeA;
});

function formatCzechDate(dateStr) {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return dateStr;
  
  const months = [
    'ledna', 'února', 'března', 'dubna', 'května', 'června',
    'července', 'srpna', 'září', 'října', 'listopadu', 'prosince'
  ];
  
  return `${d.getDate()}. ${months[d.getMonth()]} ${d.getFullYear()}`;
}
---

<html lang="cs">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SYS_DASHBOARD // BandControl</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700&display=swap" rel="stylesheet">
  
  <style>
    :root { 
      --border-color: #27272a; 
      --text-main: #9ca3af; 
      --accent-orange: #d97706;
    }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      margin: 0;
      background: #0a0a0a;
      color: #fff;
    }

    .dashboard-layout { width: 100%; display: flex; flex-direction: column; min-height: 100vh; }
    
    .dashboard-container {
      padding: 24px;
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
      flex: 1;
      box-sizing: border-box;
    }

    .dashboard-wrapper {
      background: #0a0a0a;
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 24px;
    }

    .modules-rack-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 20px;
    }

    .admin-panel-box.full-width {
      grid-column: 1 / -1;
    }

    .admin-panel-box {
      background: #121212;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 0 20px 6px 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .panel-title {
      font-size: 0.95rem;
      font-weight: bold;
      letter-spacing: 0.5px;
      color: var(--text-main);
      text-transform: uppercase;
      font-family: 'Orbitron', sans-serif;
      padding: 10px 0 6px 0;
      margin: 0 0 4px 0;
      border-bottom: 1px solid var(--border-color);
    }

    .warp-tabs {
      display: flex;
      gap: 4px;
      border-bottom: 1px solid var(--border-color);
      padding: 12px 0 0 0;
      margin-bottom: 12px;
    }

    .tab-btn {
      background: #18181b;
      border: 1px solid var(--border-color);
      border-bottom: none;
      color: #71717a;
      padding: 8px 16px;
      font-family: 'Orbitron', sans-serif;
      font-size: 0.8rem;
      font-weight: bold;
      border-top-left-radius: 6px;
      border-top-right-radius: 6px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .tab-btn:hover {
      color: #fff;
      background: #202024;
    }

    .tab-btn.active {
      background: #121212;
      color: #fbbf24;
      border-color: var(--border-color);
      border-bottom: 1px solid #121212;
      margin-bottom: -1px;
    }

    .tab-content {
      display: none;
    }

    .tab-content.active {
      display: block;
    }

    .events-table-wrapper {
      min-height: 380px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .events-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0 4px;
    }

    .events-table tr {
      background: #18181b;
      border: 1px solid var(--border-color);
      transition: all 0.2s;
    }

    .events-table tr.row-past {
      background: #141416;
      opacity: 0.75;
    }
    .events-table tr.row-past td {
      color: #71717a !important;
    }
    .events-table tr.row-past td.event-location {
      color: #71717a !important;
    }

    .events-table tr.row-future td {
      color: #a1a1aa !important;
    }
    .events-table tr.row-future td.event-location {
      color: #a1a1aa !important;
    }

    .events-table tr.row-active-upcoming {
      border-color: var(--accent-orange);
      background: #1f140c !important;
    }
    .events-table tr.row-active-upcoming td {
      color: #fbbf24 !important;
      font-weight: bold;
    }
    .events-table tr.row-active-upcoming td.event-location {
      color: #f59e0b !important;
    }

    .events-table td {
      padding: 6px 14px;
      font-size: 0.85rem;
      border-top: 1px solid var(--border-color);
      border-bottom: 1px solid var(--border-color);
      white-space: nowrap;
    }

    .events-table td:first-child {
      border-left: 1px solid var(--border-color);
      border-top-left-radius: 4px;
      border-bottom-left-radius: 4px;
      width: 25%;
    }

    .event-location {
      width: 35%;
    }

    .events-table td:nth-child(3) {
      width: 25%;
    }

    .events-table td:last-child {
      border-right: 1px solid var(--border-color);
      border-top-right-radius: 4px;
      border-bottom-right-radius: 4px;
      text-align: right;
      font-family: monospace;
      width: 15%;
    }

    .pagination-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 8px 0 6px 0;
      padding-top: 8px;
      border-top: 1px solid var(--border-color);
      font-size: 0.85rem;
      color: var(--text-main);
    }

    .pagination-btns {
      display: flex;
      gap: 8px;
    }

    .page-btn {
      background: linear-gradient(180deg, #3a3a3a 0%, #1c1c1c 60%, #111 100%);
      border: 1px solid #000;
      color: #aaa;
      padding: 6px 14px;
      border-radius: 4px;
      font-family: 'Orbitron', sans-serif;
      font-size: 0.8rem;
      cursor: pointer;
      box-shadow: 0 2px 5px rgba(0,0,0,0.4);
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .page-btn:hover:not(:disabled) {
      color: #fff;
      background: linear-gradient(180deg, #1c1c1c 0%, #3a3a3a 50%, #1c1c1c 100%);
    }

    .page-btn:disabled {
      opacity: 0.3;
      cursor: not-allowed;
      box-shadow: none;
      background: #18181b;
      border-color: #27272a;
    }

    /* Kontejner pro rozbalovací zápisy - bez omezujícího posuvníku */
    .activities-list-container {
      min-height: 380px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding-bottom: 10px;
    }

    .item-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .item-row {
      background: #18181b;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      padding: 8px 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
    }

    .item-main-text {
      font-weight: bold;
      font-size: 0.9rem;
      color: var(--text-main);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .item-sub-text {
      color: #a1a1aa;
      font-size: 0.8rem;
      white-space: nowrap;
    }

    .empty-notice {
      color: #4b5563;
      font-size: 0.85rem;
      font-style: italic;
      padding: 10px 0;
      text-align: center;
    }

    .stats-table {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .stat-row {
      background: #18181b;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      padding: 8px 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.9rem;
      color: var(--text-main);
    }

    .stat-row span:last-child {
      font-weight: bold;
      color: #fbbf24;
      font-family: monospace;
    }

    .action-btn {
      display: block;
      width: 100%;
      background: linear-gradient(180deg, #3a3a3a 0%, #1c1c1c 60%, #111 100%);
      border: 1px solid #000;
      color: var(--text-main);
      padding: 10px 16px;
      text-align: center;
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: bold;
      border-radius: 4px;
      cursor: pointer;
      box-shadow: 0 3px 0 #000, 0 5px 10px rgba(0,0,0,0.5);
      transition: all 0.2s ease;
    }

    .action-btn:hover {
      color: #fff;
      background: linear-gradient(180deg, #1c1c1c 0%, #3a3a3a 50%, #1c1c1c 100%);
    }

    .action-btn.admin-only {
      background: var(--accent-orange);
      color: #fff;
      border-color: #b45309;
      display: none;
    }

    .action-btn.admin-only:hover {
      background: #b45309;
    }
  </style>
</head>
<body>
  <script is:inline>
    if (!sessionStorage.getItem('jePrihlasen')) window.location.href = '/login';
  </script>

  <main id="dashboard-content" class="dashboard-layout">
    <NavigationDrawer />
    <Header />

    <div class="dashboard-container">
      <div class="dashboard-wrapper">
        <div class="modules-rack-row">
          
          <!-- HORNÍ VELKÉ OKNO S PŘEPÍNACÍMI ZÁLOŽKAMI -->
          <section class="admin-panel-box full-width" style="padding-top: 0;">
            <div class="warp-tabs">
              <button class="tab-btn active" data-tab="tab-events">PŘEHLED AKCÍ</button>
              <button class="tab-btn" data-tab="tab-activities">ZÁPISY</button>
            </div>

            <!-- ZÁLOŽKA 1: AKCE -->
            <div id="tab-events" class="tab-content active">
              {upcomingEvents.length > 0 ? (
                <div class="events-table-wrapper">
                  <table class="events-table" id="events-table">
                    <tbody>
                      {upcomingEvents.map((ev: any, index: number) => {
                        const isNextUpcoming = ev.timestamp === nextFutureId;
                        const isPast = ev.timestamp < todayTimestamp;
                        
                        let rowClass = 'row-future';
                        if (isNextUpcoming) {
                          rowClass = 'row-active-upcoming';
                        } else if (isPast) {
                          rowClass = 'row-past';
                        }

                        const pageSize = 10;
                        const isHidden = index >= pageSize ? 'display: none;' : '';

                        return (
                          <tr class={rowClass} data-index={index} style={isHidden}>
                            <td>{ev.title}</td>
                            <td class="event-location">{ev.location}</td>
                            <td>{formatCzechDate(ev.date)}</td>
                            <td>{ev.time || '—'}</td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>

                  <div class="pagination-bar">
                    <div class="pagination-btns">
                      <button class="page-btn" id="prev-page" disabled title="Předchozí stránka">◀</button>
                      <button class="page-btn" id="next-page" disabled={upcomingEvents.length <= 10} title="Další stránka">▶</button>
                    </div>
                    <span id="page-info">Stránka 1 z {Math.ceil(upcomingEvents.length / 10)}</span>
                  </div>
                </div>
              ) : (
                <p class="empty-notice">Žádné naplánované akce.</p>
              )}
            </div>

            <!-- ZÁLOŽKA 2: ZÁPISY -->
            <div id="tab-activities" class="tab-content">
              <div class="activities-list-container">
                {sortedActivities && sortedActivities.length > 0 ? (
                  sortedActivities.map((activity: any, index: number) => (
                    <div class="activity-card" data-index={index} style="background: #1c1c1c; border: 1px solid #333; padding: 12px 16px; border-radius: 6px; cursor: pointer; transition: border-color 0.2s;">
                      <div style="font-weight: bold; color: #ff8800; font-size: 1.1rem;">
                        <span>{activity.data.title || activity.id}</span>
                      </div>

                      <div class="activity-full-content" style="display: none; margin-top: 12px; padding-top: 12px; border-top: 1px solid #333; color: #ddd; font-size: 0.95rem; white-space: pre-wrap; line-height: 1.5;">
                        {activity.body || 'Žádný text'}
                      </div>
                    </div>
                  ))
                ) : (
                  <div class="empty-notice">Žádné zápisy nebyly nalezeny.</div>
                )}
              </div>
            </div>
          </section>

          <!-- BOX 2: Playlisty -->
          <section class="admin-panel-box conditional-box">
            <h2 class="panel-title">Uložené playlisty</h2>
            {playlists.length > 0 ? (
              <div style="max-height: 220px; overflow-y: auto; margin-bottom: 10px;">
                <div class="item-list">
                  {playlists.map((pl: any) => (
                    <div class="item-row">
                      <span class="item-main-text" style="flex: 1;">{pl.name || pl.title || 'Bezejmenný playlist'}</span>
                      <span class="item-sub-text">Počet písní: {pl.songs ? pl.songs.length : (pl.items?.length || 0)}</span>
                    </div>
                  ))}
                </div>
              </div>
            ) : (
              <p class="empty-notice">Žádné playlisty k zobrazení.</p>
            )}
          </section>

          <!-- BOX 3: Statistické informace -->
          <section class="admin-panel-box conditional-box">
            <h2 class="panel-title">Statistiky systému</h2>
            <div class="stats-table" style="margin-bottom: 10px;">
              <div class="stat-row">
                <span>Písně</span>
                <span>{songsCount}</span>
              </div>
              <div class="stat-row">
                <span>Playlisty</span>
                <span>{playlists.length}</span>
              </div>
              <div class="stat-row">
                <span>Audio soubory</span>
                <span>{audioFilesCount}</span>
              </div>
              <div class="stat-row">
                <span>Budoucí události</span>
                <span>{futureEvents.length}</span>
              </div>
              <div class="stat-row">
                <span>Zápisy</span>
                <span>{sortedActivities.length}</span>
              </div>
            </div>
          </section>

          <!-- BOX 4: Systémové operace -->
          <section class="admin-panel-box conditional-box">
            <h2 class="panel-title">Systémové operace</h2>
            <div style="display: flex; flex-direction: column; gap: 10px; margin: 4px 0 10px 0;">
              <a href="/admin" id="admin-link-btn" class="action-btn admin-only">Otevřít Admin Panel</a>
              <button class="action-btn" onclick="window.location.reload()">Obnovit data</button>
            </div>
          </section>

        </div>
      </div>
    </div>

    <Footer />
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Přepínání záložek
      const tabs = document.querySelectorAll('.tab-btn');
      const contents = document.querySelectorAll('.tab-content');
      const conditionalBoxes = document.querySelectorAll('.conditional-box');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          contents.forEach(c => c.classList.remove('active'));
          
          tab.classList.add('active');
          const targetId = tab.dataset.tab;
          document.getElementById(targetId).classList.add('active');

          // Skrytí/zobrazení spodních boxů podle aktivní záložky
          if (targetId === 'tab-activities') {
            conditionalBoxes.forEach(box => box.style.display = 'none');
          } else {
            conditionalBoxes.forEach(box => box.style.display = 'flex');
          }
        });
      });

      // Rozbalování karet zápisů
      document.querySelectorAll('.activity-card').forEach(card => {
        card.addEventListener('click', () => {
          const fullContent = card.querySelector('.activity-full-content');
          
          if (fullContent.style.display === 'none') {
            fullContent.style.display = 'block';
            card.style.borderColor = '#ff8800';
          } else {
            fullContent.style.display = 'none';
            card.style.borderColor = '#333';
          }
        });
      });
    });

    let currentPage = 0;
    const pageSize = 10;
    const rows = document.querySelectorAll('#events-table tbody tr');
    const totalPages = Math.ceil(rows.length / pageSize);

    const prevBtn = document.getElementById('prev-page');
    const nextBtn = document.getElementById('next-page');
    const pageInfo = document.getElementById('page-info');

    function updateTable() {
      rows.forEach((row, index) => {
        if (index >= currentPage * pageSize && index < (currentPage + 1) * pageSize) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });

      if (pageInfo) {
        pageInfo.textContent = `Stránka ${currentPage + 1} z ${totalPages || 1}`;
      }
      if (prevBtn) prevBtn.disabled = currentPage === 0;
      if (nextBtn) nextBtn.disabled = currentPage >= totalPages - 1;
    }

    if (prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentPage > 0) {
          currentPage--;
          updateTable();
        }
      });

      nextBtn.addEventListener('click', () => {
        if (currentPage < totalPages - 1) {
          currentPage++;
          updateTable();
        }
      });
    }

    const userRole = sessionStorage.getItem('role') || sessionStorage.getItem('uzivatelRole');
    const isAdmin = sessionStorage.getItem('isAdmin') === 'true' || userRole === 'admin' || sessionStorage.getItem('jmeno') === 'Admin';

    if (isAdmin || sessionStorage.getItem('jeAdmin') === 'true') {
      const adminBtn = document.getElementById('admin-link-btn');
      if (adminBtn) adminBtn.style.display = 'block';
    }

    document.addEventListener('click', (e) => {
      if (e.target.closest('#logout-btn')) {
        sessionStorage.clear();
        window.location.href = '/login';
      }
    });
  </script>
</body>
</html>