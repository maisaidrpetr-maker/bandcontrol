<html lang="cs">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Blue Heart — aktuální playlist</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700&display=swap" rel="stylesheet">
  
  <style>
    :root { 
      --border-color: #27272a; 
      --text-main: #9ca3af; 
      --accent-orange: #d97706;
    }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      margin: 0;
      background: #0a0a0a;
      color: #fff;
    }

    .dashboard-layout { width: 100%; display: flex; flex-direction: column; min-height: 100vh; }
    
    .dashboard-container {
      padding: 24px;
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
      flex: 1;
      box-sizing: border-box;
    }

    .dashboard-wrapper {
      background: #0a0a0a;
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 24px;
    }

    .modules-rack-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 20px;
    }

    .admin-panel-box.full-width {
      grid-column: 1 / -1;
    }

    .admin-panel-box {
      background: #121212;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 0 20px 6px 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .panel-title {
      font-size: 0.95rem;
      font-weight: bold;
      letter-spacing: 0.5px;
      color: var(--text-main);
      text-transform: uppercase;
      font-family: 'Orbitron', sans-serif;
      padding: 10px 0 6px 0;
      margin: 0 0 4px 0;
      border-bottom: 1px solid var(--border-color);
    }

    .warp-tabs {
      display: flex;
      gap: 4px;
      border-bottom: 1px solid var(--border-color);
      padding: 12px 0 0 0;
      margin-bottom: 12px;
    }

    .tab-btn {
      background: #18181b;
      border: 1px solid var(--border-color);
      border-bottom: none;
      color: #71717a;
      padding: 8px 16px;
      font-family: 'Orbitron', sans-serif;
      font-size: 0.8rem;
      font-weight: bold;
      border-top-left-radius: 6px;
      border-top-right-radius: 6px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .tab-btn:hover {
      color: #fff;
      background: #202024;
    }

    .tab-btn.active {
      background: #121212;
      color: #fbbf24;
      border-color: var(--border-color);
      border-bottom: 1px solid #121212;
      margin-bottom: -1px;
    }

    .tab-content {
      display: none;
    }

    .tab-content.active {
      display: block;
    }

    .events-table-wrapper {
      min-height: 380px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .events-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0 4px;
    }

    .events-table tr {
      background: #18181b;
      border: 1px solid var(--border-color);
      transition: all 0.2s;
    }

    .events-table tr.row-past {
      background: #141416;
      opacity: 0.75;
    }
    .events-table tr.row-past td {
      color: #71717a !important;
    }
    .events-table tr.row-past td.event-location {
      color: #71717a !important;
    }

    .events-table tr.row-future td {
      color: #a1a1aa !important;
    }
    .events-table tr.row-future td.event-location {
      color: #a1a1aa !important;
    }

    .events-table tr.row-active-upcoming {
      border-color: var(--accent-orange);
      background: #1f140c !important;
    }
    .events-table tr.row-active-upcoming td {
      color: #fbbf24 !important;
      font-weight: bold;
    }
    .events-table tr.row-active-upcoming td.event-location {
      color: #f59e0b !important;
    }

    .events-table td {
      padding: 6px 14px;
      font-size: 0.85rem;
      border-top: 1px solid var(--border-color);
      border-bottom: 1px solid var(--border-color);
      white-space: nowrap;
    }

    .events-table td:first-child {
      border-left: 1px solid var(--border-color);
      border-top-left-radius: 4px;
      border-bottom-left-radius: 4px;
      width: 25%;
    }

    .event-location {
      width: 35%;
    }

    .events-table td:nth-child(3) {
      width: 25%;
    }

    .events-table td:last-child {
      border-right: 1px solid var(--border-color);
      border-top-right-radius: 4px;
      border-bottom-right-radius: 4px;
      text-align: right;
      font-family: monospace;
      width: 15%;
    }

    .pagination-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 8px 0 6px 0;
      padding-top: 8px;
      border-top: 1px solid var(--border-color);
      font-size: 0.85rem;
      color: var(--text-main);
    }

    .pagination-btns {
      display: flex;
      gap: 8px;
    }

    .page-btn {
      background: linear-gradient(180deg, #3a3a3a 0%, #1c1c1c 60%, #111 100%);
      border: 1px solid #000;
      color: #aaa;
      padding: 6px 14px;
      border-radius: 4px;
      font-family: 'Orbitron', sans-serif;
      font-size: 0.8rem;
      cursor: pointer;
      box-shadow: 0 2px 5px rgba(0,0,0,0.4);
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .page-btn:hover:not(:disabled) {
      color: #fff;
      background: linear-gradient(180deg, #1c1c1c 0%, #3a3a3a 50%, #1c1c1c 100%);
    }

    .page-btn:disabled {
      opacity: 0.3;
      cursor: not-allowed;
      box-shadow: none;
      background: #18181b;
      border-color: #27272a;
    }

    .activities-list-container {
      min-height: 380px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding-bottom: 10px;
    }

    .item-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .item-row {
      background: #18181b;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      padding: 8px 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
    }

    .item-main-text {
      font-weight: bold;
      font-size: 0.9rem;
      color: var(--text-main);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .item-sub-text {
      color: #a1a1aa;
      font-size: 0.8rem;
      white-space: nowrap;
    }

    .empty-notice {
      color: #4b5563;
      font-size: 0.85rem;
      font-style: italic;
      padding: 10px 0;
      text-align: center;
    }

    .stats-table {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .stat-row {
      background: #18181b;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      padding: 8px 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.9rem;
      color: var(--text-main);
    }

    .stat-row span:last-child {
      font-weight: bold;
      color: #fbbf24;
      font-family: monospace;
    }

    .action-btn {
  display: block;
  width: 100%;
  max-width: 210px; /* nebo třeba 250px podle potřeby */
  margin: 0 auto;  /* vycentruje je v boxu */
  background: linear-gradient(180deg, #3a3a3a 0%, #1c1c1c 60%, #111 100%);
  border: 1px solid #000;
  color: var(--text-main);
  padding: 10px 16px;
  text-align: center;
  text-decoration: none;
  font-size: 0.85rem;
  font-weight: bold;
  border-radius: 4px;
  cursor: pointer;
  box-shadow: 0 3px 0 #000, 0 5px 10px rgba(0,0,0,0.5);
  transition: all 0.2s ease;
  box-sizing: border-box;
}

    .action-btn:hover {
      color: #fff;
      background: linear-gradient(180deg, #1c1c1c 0%, #3a3a3a 50%, #1c1c1c 100%);
    }

    .action-btn.admin-only {
      background: var(--accent-orange);
      color: #fff;
      border-color: #b45309;
      display: none;
    }

    .action-btn.orange-btn {
      background: var(--accent-orange);
      color: #fff;
      border-color: #b45309;
    }

    .action-btn.orange-btn:hover {
      background: #b45309;
    }

    /* ==========================================
       TISKOVÁ ŠABLONA (Identická jako /stage)
       ========================================== */
    #print-playlist-container {
      display: none;
    }

    @page {
      size: auto;
      margin: 12mm 10mm;
    }

    @media print {
      body * {
        visibility: hidden;
      }
      #print-playlist-container, #print-playlist-container * {
        visibility: visible;
      }
      #print-playlist-container {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        margin: 0;
        padding: 25px 10mm 0 10mm !important;
        color: #000 !important;
        background: #fff !important;
        display: block !important;
      }
      
      .print-header-row {
        display: grid !important;
        grid-template-columns: auto 1fr auto !important;
        align-items: center !important;
        width: 100% !important;
        background: #e6e6e6 !important;
        padding: 12px 15px 12px 135px !important;
        min-height: 50px !important;
        position: relative !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        page-break-after: avoid !important;
        break-after: avoid !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
      }

      .print-container-inner:has(.print-header-second) > .print-header-row:first-of-type::after {
        content: "1/2" !important;
        font-weight: bold !important;
        font-size: 1.4rem !important;
        color: #333 !important;
        padding-right: 5px !important;
        justify-self: end !important;
      }

      .print-header-second {
        display: flex !important;
        visibility: visible !important;
        height: auto !important;
        overflow: visible !important;
        page-break-before: always !important;
        break-before: page !important;
        margin-top: 25px !important; 
      }

      .print-container-inner:has(.print-header-second) .print-header-second::after {
        content: "2/2" !important;
        font-weight: bold !important;
        font-size: 1.4rem !important;
        color: #333 !important;
        padding-right: 5px !important;
        justify-self: end !important;
      }

      .print-logo {
        display: block !important;
        position: absolute !important;
        left: 15px !important;
        top: -20px !important;
        height: 100px !important;
        width: auto !important;
        z-index: 10 !important;
      }

      .print-header-row h1 {
        color: #000 !important;
        border: none !important;
        margin: 0 !important;
        font-size: 2.2rem !important;
        text-align: left !important;
        background: transparent !important;
        padding: 0 !important;
        letter-spacing: 0.5px;
        font-weight: bold !important;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
        flex-grow: 1 !important;
      }

      .print-song-list {
        margin-top: 15px !important;
        display: block !important;
      }
      .print-song-card {
        background: #fff !important;
        border: none !important;
        box-shadow: none !important;
        background-image: linear-gradient(to bottom, #777, #777) !important;
        background-size: 100% 1px !important;
        background-position: bottom !important;
        background-repeat: no-repeat !important;
        color: #000 !important;
        padding: 4px 6px 6px 6px !important;
        margin-bottom: 0 !important;
        font-size: 1.8rem !important;
        line-height: 1.2 !important;
        border-radius: 0 !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      .print-song-left {
        display: flex !important;
        align-items: center !important;
        gap: 15px !important;
        font-weight: 600 !important;
      }
      .print-song-index {
        color: #000 !important;
        font-weight: bold;
        min-width: 45px;
      }
      .print-song-meta {
        display: flex !important;
        gap: 15px !important;
      }
      .print-badge-slot {
        display: inline-block !important;
        width: auto !important;
      }
      .print-badge {
        background: transparent !important;
        border: none !important;
        font-weight: bold !important;
        font-size: 1.8rem !important;
        padding: 0 !important;
        width: 55px !important;
        min-width: 55px !important;
        text-align: center !important;
        display: inline-block !important;
      }
      .print-badge.print-key { color: #d00000 !important; }
      .print-badge.print-capo { color: #000 !important; }
      .print-badge.print-bpm { color: #0284c7 !important; }
      .print-badge-placeholder {
        display: inline-block !important;
        visibility: hidden !important;
        width: 55px !important;
        min-width: 55px !important;
      }
    }
  </style>
</head>
<body>
  <script is:inline>
    if (!sessionStorage.getItem('jePrihlasen')) window.location.href = '/login';
  </script>

  <main id="dashboard-content" class="dashboard-layout">
    <NavigationDrawer />
    <Header />

    <div class="dashboard-container">
      <div class="dashboard-wrapper">
        <div class="modules-rack-row">
          
          <!-- HORNÍ VELKÉ OKNO S PŘEPÍNACÍMI ZÁLOŽKAMI -->
<section class="admin-panel-box full-width" style="padding-top: 0;">
  <div class="warp-tabs" style="margin-top: 0;">
    <button class="tab-btn active" data-tab="tab-events" style="font-size: 1.15rem; padding: 12px 24px;">Board</button>
    <button class="tab-btn" data-tab="tab-activities" style="font-size: 1.15rem; padding: 12px 24px;">Zápisy</button>
  </div>

  <!-- ZÁLOŽKA 1: AKCE (BOARD) -->
  <div id="tab-events" class="tab-content active" style="padding-top: 14px;">
    <h2 class="panel-title" style="margin-bottom: 14px;">Přehled akcí</h2>
    {upcomingEvents.length > 0 ? (
      <div class="events-table-wrapper">
        <table class="events-table" id="events-table">
          <tbody>
            {upcomingEvents.map((ev: any, index: number) => {
              const isNextUpcoming = ev.timestamp === nextFutureId;
              const isPast = ev.timestamp < todayTimestamp;
              
              let rowClass = 'row-future';
              if (isNextUpcoming) {
                rowClass = 'row-active-upcoming';
              } else if (isPast) {
                rowClass = 'row-past';
              }

              const pageSize = 10;
              const isHidden = index >= pageSize ? 'display: none;' : '';

              return (
                <tr class={rowClass} data-index={index} style={isHidden}>
                  <td>{ev.title}</td>
                  <td class="event-location">{ev.location}</td>
                  <td>{formatCzechDate(ev.date)}</td>
                  <td>{ev.time || '—'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>

        <div class="pagination-bar">
          <div class="pagination-btns">
            <button class="page-btn" id="prev-page" disabled title="Předchozí stránka">◀</button>
            <button class="page-btn" id="next-page" disabled={upcomingEvents.length <= 10} title="Další stránka">▶</button>
          </div>
          <span id="page-info">Stránka 1 z {Math.ceil(upcomingEvents.length / 10)}</span>
        </div>
      </div>
    ) : (
      <p class="empty-notice">Žádné naplánované akce.</p>
    )}
  </div>

  <!-- ZÁLOŽKA 2: ZÁPISY -->
  <div id="tab-activities" class="tab-content" style="padding-top: 14px;">
    <div class="activities-list-container">
      {sortedActivities && sortedActivities.length > 0 ? (
        sortedActivities.map((activity: any, index: number) => (
          <div class="activity-card" data-index={index} style="background: #1c1c1c; border: 1px solid #333; padding: 12px 16px; border-radius: 6px; cursor: pointer; transition: border-color 0.2s;">
            <div style="font-weight: bold; color: #ff8800; font-size: 1.1rem;">
              <span>{activity.data.title || activity.id}</span>
            </div>

            <div class="activity-full-content" style="display: none; margin-top: 12px; padding-top: 12px; border-top: 1px solid #333; color: #ddd; font-size: 0.95rem; white-space: pre-wrap; line-height: 1.5;">
              {activity.body || 'Žádný text'}
            </div>
          </div>
        ))
      ) : (
        <div class="empty-notice">Žádné zápisy nebyly nalezeny.</div>
      )}
    </div>
  </div>
</section>

          <!-- BOX 2: Playlisty -->
          <section class="admin-panel-box conditional-box">
            <h2 class="panel-title">Uložené playlisty</h2>
            {allPlaylistsForList.length > 0 ? (
              <div style="max-height: 220px; overflow-y: auto; margin-bottom: 10px;">
                <div class="item-list">
                  {allPlaylistsForList.map((pl: any) => (
                    <div class="item-row">
                      <span class="item-main-text" style="flex: 1;">{pl.name || pl.title || 'Bezejmenný playlist'}</span>
                      <span class="item-sub-text">Počet písní: {pl.songs ? pl.songs.length : (pl.items?.length || 0)}</span>
                    </div>
                  ))}
                </div>
              </div>
            ) : (
              <p class="empty-notice">Žádné playlisty k zobrazení.</p>
            )}
          </section>

          <!-- BOX 3: Statistiky systému -->
          <section class="admin-panel-box conditional-box">
            <h2 class="panel-title">Statistiky systému</h2>
            <div class="stats-table" style="margin-bottom: 10px;">
              <div class="stat-row"><span>Písně</span><span>{songsCount}</span></div>
              <div class="stat-row"><span>Playlisty</span><span>{allPlaylistsForList.length}</span></div>
              <div class="stat-row"><span>Audio soubory</span><span>{audioFilesCount}</span></div>
              <div class="stat-row"><span>Budoucí události</span><span>{futureEvents.length}</span></div>
              <div class="stat-row"><span>Zápisy</span><span>{sortedActivities.length}</span></div>
            </div>
          </section>

          <!-- BOX 4: Systémové operace -->
<section class="admin-panel-box conditional-box">
  <h2 class="panel-title">Systémové operace</h2>
  <div style="display: flex; flex-direction: column; gap: 10px; margin: 4px 0 14px 0;">
    <a href="/admin" id="admin-link-btn" class="action-btn admin-only">Otevřít Admin Panel</a>
    <button class="action-btn orange-btn" onclick="window.print()">Tisk aktuálního playlistu</button>
    <button class="action-btn orange-btn" onclick="window.location.reload()">Znovu načíst stránku</button>
  </div>
  
  <div class="stats-table">
    <div style="text-align: center; font-weight: bold; font-size: 0.85rem; margin-bottom: 4px; color: var(--text-main);">Poslední aktualizace</div>
    <div class="stat-row">
      <span style="font-size: 0.8rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 170px;" title={githubLatestCommit}>{githubLatestCommit}</span>
      {commits.length > 0 && <span style="color: #f0a500; font-weight: bold; flex-shrink: 0;">{formattedCommitDate}</span>}
    </div>
    <div class="stat-row"><span>Celkový počet změn</span><span>{githubTotalCommits}</span></div>
    <div class="stat-row"><span>Celkový počet souborů</span><span>{githubTotalFiles}</span></div>
  </div>
</section>

        </div>
      </div>
    </div>

    <!-- SKRYTÝ TISKOVÝ KONTEJNER (Stejná struktura jako /stage) -->
    <div id="print-playlist-container">
      <div class="print-container-inner">
        <div class="print-header-row">
          <img src="/images/BHlogo.png" alt="Logo kapely" class="print-logo" />
          <h1>{activePlaylist ? activePlaylist.name : 'ŽÁDNÝ PLAYLIST'}</h1>
        </div>

        {activePlaylist && activePlaylist.songs ? (
          <div class="print-song-list">
            {activePlaylist.songs.map((songId: string, index: number) => {
              const song = lyricsMap[songId] || { title: songId, key: '', capo: '', bpm: '' };
              const isTwentyFirst = index === 20;
              const formattedCapo = song.capo !== '' && song.capo !== '-' && song.capo !== 0 ? `C${song.capo}` : '';
              
              return (
                <>
                  {isTwentyFirst && (
                    <div class="print-header-row print-header-second">
                      <img src="/images/BHlogo.png" alt="Logo kapely" class="print-logo" />
                      <h1>{activePlaylist.name}</h1>
                    </div>
                  )}
                  <div class="print-song-card">
                    <div class="print-song-left">
                      <span class="print-song-index">{index + 1}.</span>
                      <span>{song.title}</span>
                    </div>
                    <div class="print-song-meta">
                      <!-- Tónina -->
                      <div class="print-badge-slot">
                        {song.key ? <span class="print-badge print-key">{song.key}</span> : <span class="print-badge print-badge-placeholder">&nbsp;</span>}
                      </div>
                      <!-- Capo -->
                      <div class="print-badge-slot">
                        {formattedCapo !== '' ? <span class="print-badge print-capo">{formattedCapo}</span> : <span class="print-badge print-badge-placeholder">&nbsp;</span>}
                      </div>
                      <!-- BPM -->
                      <div class="print-badge-slot">
                        {song.bpm !== '' ? <span class="print-badge print-bpm">{song.bpm}</span> : <span class="print-badge print-badge-placeholder">&nbsp;</span>}
                      </div>
                    </div>
                  </div>
                </>
              );
            })}
          </div>
        ) : (
          <p>Žádný playlist k tisku.</p>
        )}
      </div>
    </div>

    <Footer />
  </main>

  <script>
    function initDashboard() {
      const tabs = document.querySelectorAll('.tab-btn');
      const contents = document.querySelectorAll('.tab-content');
      const conditionalBoxes = document.querySelectorAll('.conditional-box');

      tabs.forEach(tab => {
        tab.replaceWith(tab.cloneNode(true));
      });

      const freshTabs = document.querySelectorAll('.tab-btn');
      freshTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          freshTabs.forEach(t => t.classList.remove('active'));
          contents.forEach(c => c.classList.remove('active'));
          
          tab.classList.add('active');
          const targetId = tab.dataset.tab;
          const targetContent = document.getElementById(targetId);
          if (targetContent) targetContent.classList.add('active');

          if (targetId === 'tab-activities') {
            conditionalBoxes.forEach(box => box.style.display = 'none');
          } else {
            conditionalBoxes.forEach(box => box.style.display = 'flex');
          }
        });
      });

      document.querySelectorAll('.activity-card').forEach(card => {
        card.addEventListener('click', () => {
          const fullContent = card.querySelector('.activity-full-content');
          if (fullContent) {
            if (fullContent.style.display === 'none') {
              fullContent.style.display = 'block';
              card.style.borderColor = '#ff8800';
            } else {
              fullContent.style.display = 'none';
              card.style.borderColor = '#333';
            }
          }
        });
      });
    }

    document.addEventListener('DOMContentLoaded', initDashboard);
    document.addEventListener('astro:page-load', initDashboard);

    let currentPage = 0;
    const pageSize = 10;
    const rows = document.querySelectorAll('#events-table tbody tr');
    const totalPages = Math.ceil(rows.length / pageSize);

    const prevBtn = document.getElementById('prev-page');
    const nextBtn = document.getElementById('next-page');
    const pageInfo = document.getElementById('page-info');

    function updateTable() {
      rows.forEach((row, index) => {
        if (index >= currentPage * pageSize && index < (currentPage + 1) * pageSize) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
      if (pageInfo) pageInfo.textContent = `Stránka ${currentPage + 1} z ${totalPages || 1}`;
      if (prevBtn) prevBtn.disabled = currentPage === 0;
      if (nextBtn) nextBtn.disabled = currentPage >= totalPages - 1;
    }

    if (prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => { if (currentPage > 0) { currentPage--; updateTable(); } });
      nextBtn.addEventListener('click', () => { if (currentPage < totalPages - 1) { currentPage++; updateTable(); } });
    }

    const userRole = sessionStorage.getItem('role') || sessionStorage.getItem('uzivatelRole');
    const isAdmin = sessionStorage.getItem('isAdmin') === 'true' || userRole === 'admin' || sessionStorage.getItem('jmeno') === 'Admin';
    if (isAdmin || sessionStorage.getItem('jeAdmin') === 'true') {
      const adminBtn = document.getElementById('admin-link-btn');
      if (adminBtn) adminBtn.style.display = 'block';
    }

    document.addEventListener('click', (e) => {
      if (e.target.closest('#logout-btn')) {
        sessionStorage.clear();
        window.location.href = '/login';
      }
    });
  </script>
</body>
</html>