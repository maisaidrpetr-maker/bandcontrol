---
/* src/pages/dashboard.astro */
import NavigationDrawer from '../components/NavigationDrawer.astro';
import Header from '../components/Header.astro';
import OverviewModule from '../components/OverviewModule.astro';
import EventsModule from '../components/EventsModule.astro';
---

<html lang="cs">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BandControl</title>
  <style>
    :root {
      --bg-dark: #050505;
      --border-color: #27272a;
      --text-main: #f4f4f5;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: system-ui, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }

    .dashboard-layout {
      width: 100%;
      display: flex;
      flex-direction: column;
    }

    .modules-rack-row {
      display: flex;
      flex-wrap: wrap;
      gap: 24px;
      padding: 24px;
      justify-content: center; /* Moduly budou na středu */
      align-items: flex-start;
    }
  </style>
</head>
<body>

  <script is:inline>
    if (!sessionStorage.getItem('jePrihlasen')) {
      window.location.href = '/login';
    }
  </script>

  <main id="dashboard-content" class="dashboard-layout">
    <NavigationDrawer />
    <Header />

    <div class="modules-rack-row">
      <EventsModule />
      <OverviewModule />
    </div>
  </main>

  <script is:inline>
    document.addEventListener('click', (e) => {
      if (e.target.closest('#logout-btn')) {
        sessionStorage.clear();
        window.location.href = '/login';
      }
    });
  </script>
</body>
</html>