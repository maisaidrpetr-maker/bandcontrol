---
// src/pages/dashboard.astro
import '../styles/global.css';
import NavigationDrawer from '../components/NavigationDrawer.astro';
import Header from '../components/Header.astro';
import fs from 'node:fs';
import path from 'node:path';

// Načtení akcí z Redis API endpointu
let allEvents = [];
try {
  const response = new URL('/api/events', Astro.request.url);
  const res = await fetch(response.toString());
  if (res.ok) {
    allEvents = await res.json();
  }
} catch (e) {
  console.error('Chyba při načítání událostí:', e);
}

const now = new Date();
const todayTimestamp = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();

const processedEvents = allEvents.map((ev: any) => {
  const dateObj = new Date(ev.date + (ev.time ? `T${ev.time}` : 'T00:00:00'));
  return {
    ...ev,
    timestamp: isNaN(dateObj.getTime()) ? 0 : dateObj.getTime(),
  };
});

const futureEvents = processedEvents
  .filter(ev => ev.timestamp >= todayTimestamp)
  .sort((a, b) => b.timestamp - a.timestamp);

const pastEvents = processedEvents
  .filter(ev => ev.timestamp < todayTimestamp)
  .sort((a, b) => b.timestamp - a.timestamp);

// Omezení odstraněno – načtou se všechny minulé akce
const upcomingEvents = [
  ...futureEvents,
  ...pastEvents
];

const strictFuture = processedEvents
  .filter(ev => ev.timestamp >= todayTimestamp)
  .sort((a, b) => a.timestamp - b.timestamp);
const nextFutureId = strictFuture.length > 0 ? strictFuture[0].timestamp : null;

// Playlisty
let playlists = [];
try {
  const res = await fetch(new URL('/api/playlists', Astro.request.url).toString());
  if (res.ok) {
    playlists = await res.json();
  }
} catch (e) {}

// Písně (Lyrics) - načtení ze složky src/content/lyrics
let songsCount = 0;
try {
  const songsDir = path.resolve('./src/content/lyrics');
  if (fs.existsSync(songsDir)) {
    const files = fs.readdirSync(songsDir);
    songsCount = files.filter(file => file.endsWith('.md')).length;
  }
} catch (e) {}

// Audio soubory - načtení ze složky public/audio (.mp3)
let audioFilesCount = 0;
try {
  const audioDir = path.resolve('./public/audio');
  if (fs.existsSync(audioDir)) {
    const files = fs.readdirSync(audioDir);
    audioFilesCount = files.filter(file => file.toLowerCase().endsWith('.mp3')).length;
  }
} catch (e) {
  console.error('Chyba při načítání audio souborů:', e);
}

// Zápisy / Aktivity (.md soubory) - načteno ze složky src/content/activities
let markdownNotesCount = 0;
try {
  const notesDir = path.join(process.cwd(), 'src/content/activities');
  if (fs.existsSync(notesDir)) {
    const files = fs.readdirSync(notesDir);
    markdownNotesCount = files.filter(file => file.toLowerCase().endsWith('.md')).length;
  }
} catch (e) {
  console.error('Chyba při načítání zápisů:', e);
}

function formatCzechDate(dateStr) {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return dateStr;
  
  const months = [
    'ledna', 'února', 'března', 'dubna', 'května', 'června',
    'července', 'srpna', 'září', 'října', 'listopadu', 'prosince'
  ];
  
  return `${d.getDate()}. ${months[d.getMonth()]} ${d.getFullYear()}`;
}
---

<html lang="cs">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SYS_DASHBOARD // BandControl</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700&display=swap" rel="stylesheet">
  
  <style>
    :root { 
      --border-color: #27272a; 
      --text-main: #9ca3af; 
      --accent-orange: #d97706;
    }

    body {
      font-family: system-ui, -apple-system, sans-serif;
    }

    .dashboard-layout { width: 100%; display: flex; flex-direction: column; }
    
    .dashboard-container {
      padding: 24px;
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
    }

    .dashboard-wrapper {
      background: #0a0a0a;
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 24px;
    }

    .modules-rack-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 20px;
    }

    .admin-panel-box.full-width {
      grid-column: 1 / -1;
    }

    .admin-panel-box {
      background: #121212;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .panel-title {
      font-size: 0.95rem;
      font-weight: bold;
      letter-spacing: 0.5px;
      color: var(--text-main);
      text-transform: uppercase;
      font-family: 'Orbitron', sans-serif;
    }

    .table-scroll-container {
      max-height: 420px;
      overflow-y: auto;
      padding-right: 4px;
    }

    .table-scroll-container::-webkit-scrollbar {
      width: 6px;
    }
    .table-scroll-container::-webkit-scrollbar-track {
      background: #121212;
    }
    .table-scroll-container::-webkit-scrollbar-thumb {
      background: #27272a;
      border-radius: 3px;
    }
    .table-scroll-container::-webkit-scrollbar-thumb:hover {
      background: var(--accent-orange);
    }

    .events-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0 4px;
    }

    .events-table tr {
      background: #18181b;
      border: 1px solid var(--border-color);
      transition: all 0.2s;
    }

    .events-table tr.row-past {
      background: #141416;
      opacity: 0.75;
    }
    .events-table tr.row-past td {
      color: #71717a !important;
    }
    .events-table tr.row-past td.event-location {
      color: #71717a !important;
    }

    .events-table tr.row-future td {
      color: #a1a1aa !important;
    }
    .events-table tr.row-future td.event-location {
      color: #a1a1aa !important;
    }

    .events-table tr.row-active-upcoming {
      border-color: var(--accent-orange);
      background: #1f140c !important;
    }
    .events-table tr.row-active-upcoming td {
      color: #fbbf24 !important;
      font-weight: bold;
    }
    .events-table tr.row-active-upcoming td.event-location {
      color: #f59e0b !important;
    }

    .events-table td {
      padding: 6px 14px;
      font-size: 0.85rem;
      border-top: 1px solid var(--border-color);
      border-bottom: 1px solid var(--border-color);
      white-space: nowrap;
    }

    .events-table td:first-child {
      border-left: 1px solid var(--border-color);
      border-top-left-radius: 4px;
      border-bottom-left-radius: 4px;
      width: 25%;
    }

    .event-location {
      width: 35%;
    }

    .events-table td:nth-child(3) {
      width: 25%;
    }

    .events-table td:last-child {
      border-right: 1px solid var(--border-color);
      border-top-right-radius: 4px;
      border-bottom-right-radius: 4px;
      text-align: right;
      font-family: monospace;
      width: 15%;
    }

    .item-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .item-row {
      background: #18181b;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      padding: 8px 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
    }

    .item-main-text {
      font-weight: bold;
      font-size: 0.9rem;
      color: var(--text-main);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .item-sub-text {
      color: #a1a1aa;
      font-size: 0.8rem;
      white-space: nowrap;
    }

    .empty-notice {
      color: #4b5563;
      font-size: 0.85rem;
      font-style: italic;
    }

    .stats-table {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .stat-row {
      background: #18181b;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      padding: 8px 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.9rem;
      color: var(--text-main);
    }

    .stat-row span:last-child {
      font-weight: bold;
      color: #fbbf24;
      font-family: monospace;
    }

    .action-btn {
      display: block;
      width: 100%;
      background: #18181b;
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 10px 16px;
      text-align: center;
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: bold;
      border-radius: 4px;
      cursor: pointer;
      transition: background 0.2s;
    }

    .action-btn:hover {
      background: #27272a;
      border-color: #52525b;
    }

    .action-btn.admin-only {
      background: var(--accent-orange);
      color: #fff;
      border-color: #b45309;
      display: none;
    }

    .action-btn.admin-only:hover {
      background: #b45309;
    }
  </style>
</head>
<body>
  <script is:inline>
    if (!sessionStorage.getItem('jePrihlasen')) window.location.href = '/login';
  </script>

  <main id="dashboard-content" class="dashboard-layout">
    <NavigationDrawer />
    <Header />

    <div class="dashboard-container">
      <div class="dashboard-wrapper">
        <div class="modules-rack-row">
          
          <!-- BOX 1: Přehled akcí -->
          <section class="admin-panel-box full-width">
            <h2 class="panel-title">Přehled akcí</h2>
            {upcomingEvents.length > 0 ? (
              <div class="table-scroll-container">
                <table class="events-table">
                  <tbody>
                    {upcomingEvents.map((ev: any) => {
                      const isNextUpcoming = ev.timestamp === nextFutureId;
                      const isPast = ev.timestamp < todayTimestamp;
                      
                      let rowClass = 'row-future';
                      if (isNextUpcoming) {
                        rowClass = 'row-active-upcoming';
                      } else if (isPast) {
                        rowClass = 'row-past';
                      }

                      return (
                        <tr class={rowClass}>
                          <td>{ev.title}</td>
                          <td class="event-location">{ev.location}</td>
                          <td>{formatCzechDate(ev.date)}</td>
                          <td>{ev.time || '—'}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            ) : (
              <p class="empty-notice">Žádné naplánované akce.</p>
            )}
          </section>

          <!-- BOX 2: Playlisty -->
          <section class="admin-panel-box">
            <h2 class="panel-title">Uložené playlisty</h2>
            {playlists.length > 0 ? (
              <div class="table-scroll-container" style="max-height: 220px;">
                <div class="item-list">
                  {playlists.map((pl: any) => (
                    <div class="item-row">
                      <span class="item-main-text" style="flex: 1;">{pl.name || pl.title || 'Bezejmenný playlist'}</span>
                      <span class="item-sub-text">Počet písní: {pl.songs ? pl.songs.length : (pl.items?.length || 0)}</span>
                    </div>
                  ))}
                </div>
              </div>
            ) : (
              <p class="empty-notice">Žádné playlisty k zobrazení.</p>
            )}
          </section>

          <!-- BOX 3: Statistické informace -->
          <section class="admin-panel-box">
            <h2 class="panel-title">Statistiky systému</h2>
            <div class="stats-table">
              <div class="stat-row">
                <span>Písně</span>
                <span>{songsCount}</span>
              </div>
              <div class="stat-row">
                <span>Playlisty</span>
                <span>{playlists.length}</span>
              </div>
              <div class="stat-row">
                <span>Audio soubory</span>
                <span>{audioFilesCount}</span>
              </div>
              <div class="stat-row">
                <span>Budoucí události</span>
                <span>{futureEvents.length}</span>
              </div>
              <div class="stat-row">
                <span>Zápisy</span>
                <span>{markdownNotesCount}</span>
              </div>
            </div>
          </section>

          <!-- BOX 4: Systémové operace -->
          <section class="admin-panel-box">
            <h2 class="panel-title">Systémové operace</h2>
            <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 4px;">
              <a href="/admin" id="admin-link-btn" class="action-btn admin-only">Otevřít Admin Panel</a>
              <button class="action-btn" onclick="window.location.reload()">Obnovit data</button>
            </div>
          </section>

        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    const userRole = sessionStorage.getItem('role') || sessionStorage.getItem('uzivatelRole');
    const isAdmin = sessionStorage.getItem('isAdmin') === 'true' || userRole === 'admin' || sessionStorage.getItem('jmeno') === 'Admin';

    if (isAdmin || sessionStorage.getItem('jeAdmin') === 'true') {
      const adminBtn = document.getElementById('admin-link-btn');
      if (adminBtn) adminBtn.style.display = 'block';
    }

    document.addEventListener('click', (e) => {
      if (e.target.closest('#logout-btn')) {
        sessionStorage.clear();
        window.location.href = '/login';
      }
    });
  </script>
</body>
</html>