---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="BandControl - Dashboard">
  <div id="login-screen" class="login-overlay">
    <div class="login-card">
      <h1>BandControl Login</h1>
      <input 
        type="password" 
        id="password-input" 
        placeholder="Zadej heslo kapely" 
      />
      <button id="login-btn">Vstoupit do systému</button>
      <p id="login-error" class="error-msg">Nesprávné heslo!</p>
    </div>
  </div>

  <main id="dashboard-content" class="dashboard-layout hidden">
    <header class="main-header">
      <div>
        <h1 class="brand-title">BANDCONTROL v1.0</h1>
        <p class="brand-sub">Režim: Mobilní stage-ready verze</p>
      </div>
      <div class="header-actions">
        <button id="fullscreen-btn" class="btn-sec">🖥️ Fullscreen</button>
        <button id="logout-btn" class="btn-ghost">Odhlásit</button>
      </div>
    </header>

    <div class="grid-container">
      
      <section class="card border-red">
        <div>
          <h2 class="text-red">📅 NEJBLIŽŠÍ AKCE</h2>
          <div class="widget-box">
            <p class="date-highlight">Čtvrtek 28. 5.</p>
            <p class="details">Řádná zkouška v klubu (18:00)</p>
          </div>
        </div>
        <div class="button-group">
          <button class="btn-green">JDU</button>
          <button class="btn-dark">NEJDU</button>
        </div>
      </section>

      <section class="card border-blue">
        <h2 class="text-blue">⏱️ RYCHLÝ METRONOM</h2>
        <div class="widget-box center-text">
          <span class="bpm-counter">120</span>
          <span class="bpm-label">BPM</span>
        </div>
        <button class="btn-blue">START</button>
      </section>

      <section class="card border-amber">
        <h2 class="text-amber">🎵 AKTUÁLNÍ SONGY</h2>
        <ul class="song-list">
          <li>
            <span class="song-title">1. Intro (Písek)</span>
            <span class="badge">Akordy</span>
          </li>
          <li>
            <span class="song-title">2. Kovová rampa</span>
            <span class="badge-dark">Text</span>
          </li>
        </ul>
      </section>

    </div>
  </main>
</Layout>

<style>
  :root {
    --bg-dark: #09090b;
    --bg-card: #18181b;
    --bg-input: #27272a;
    --border-color: #27272a;
    --text-main: #f4f4f5;
    --text-muted: #a1a1aa;
    --red: #dc2626;
    --blue: #2563eb;
    --amber: #d97706;
    --green: #15803d;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; }
  .hidden { display: none !important; }

  .login-overlay {
    position: fixed;
    inset: 0;
    background: var(--bg-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 20px;
  }
  .login-card {
    background: var(--bg-card);
    padding: 30px;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    width: 100%;
    max-width: 360px;
    text-align: center;
  }
  .login-card h1 { color: white; margin-bottom: 20px; font-size: 24px; }
  .login-card input {
    width: 100%;
    padding: 12px;
    background: var(--bg-input);
    border: 1px solid var(--border-color);
    color: white;
    border-radius: 4px;
    text-align: center;
    font-size: 16px;
    margin-bottom: 15px;
  }
  .login-card button {
    width: 100%;
    padding: 12px;
    background: var(--red);
    color: white;
    border: none;
    font-weight: bold;
    border-radius: 4px;
    cursor: pointer;
    font-size: 16px;
  }
  .error-msg { color: var(--red); margin-top: 10px; font-size: 14px; display: none; }

  .dashboard-layout {
    background: var(--bg-dark);
    min-height: 100vh;
    color: var(--text-main);
    padding: 20px;
  }
  .main-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 20px;
    margin-bottom: 25px;
    border-bottom: 1px solid var(--border-color);
  }
  .brand-title { font-size: 24px; font-weight: 800; color: white; }
  .brand-sub { font-size: 14px; color: var(--text-muted); }
  .header-actions { display: flex; gap: 10px; }

  .btn-sec { background: var(--bg-card); color: white; border: 1px solid var(--border-color); padding: 8px 16px; border-radius: 4px; cursor: pointer; }
  .btn-ghost { background: transparent; color: var(--text-muted); border: none; cursor: pointer; padding: 8px 16px; }

  .grid-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 768px) { .grid-container { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid-container { grid-template-columns: repeat(3, 1fr); } }

  .card {
    background: var(--bg-card);
    padding: 20px;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 200px;
  }
  .border-red { border-top: 4px solid var(--red); }
  .border-blue { border-top: 4px solid var(--blue); }
  .border-amber { border-top: 4px solid var(--amber); }

  .text-red { color: var(--red); font-size: 16px; margin-bottom: 15px; }
  .text-blue { color: var(--blue); font-size: 16px; margin-bottom: 15px; }
  .text-amber { color: var(--amber); font-size: 16px; margin-bottom: 15px; }

  .widget-box { background: var(--bg-dark); padding: 15px; border-radius: 4px; border: 1px solid var(--border-color); margin-bottom: 15px; }
  .center-text { text-align: center; }
  
  .date-highlight { font-size: 20px; font-weight: bold; color: white; }
  .details { color: var(--text-muted); font-size: 14px; }
  
  .button-group { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .btn-green { background: var(--green); color: white; border: none; padding: 12px; font-weight: bold; border-radius: 4px; cursor: pointer; }
  .btn-dark { background: var(--bg-dark); color: var(--text-muted); border: 1px solid var(--border-color); padding: 12px; font-weight: bold; border-radius: 4px; cursor: pointer; }
  .btn-blue { background: var(--blue); color: white; border: none; padding: 12px; font-weight: bold; border-radius: 4px; cursor: pointer; width: 100%; }

  .bpm-counter { font-size: 48px; font-weight: 900; color: white; display: block; }
  .bpm-label { font-size: 12px; color: var(--text-muted); }

  .song-list { list-style: none; }
  .song-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--bg-dark);
    padding: 12px;
    border-radius: 4px;
    margin-bottom: 8px;
    border: 1px solid var(--border-color);
  }
  .song-title { color: white; font-weight: 500; }
  .badge { background: rgba(217, 119, 6, 0.1); color: var(--amber); padding: 4px 8px; border-radius: 4px; font-size: 12px; }
  .badge-dark { background: var(--border-color); color: var(--text-muted); padding: 4px 8px; border-radius: 4px; font-size: 12px; }

  @media (max-width: 500px) {
    .main-header { flex-direction: column; text-align: center; gap: 15px; }
    .header-actions { width: 100%; }
    .header-actions button { flex: 1; }
  }
</style>

<script>
  const MASTER_PASSWORD = "kapela2026"; // Tvoje heslo pro kluky

  const loginScreen = document.getElementById('login-screen');
  const dashboardContent = document.getElementById('dashboard-content');
  const passwordInput = document.getElementById('password-input') as HTMLInputElement;
  const loginBtn = document.getElementById('login-btn');
  const loginError = document.getElementById('login-error');
  const logoutBtn = document.getElementById('logout-btn');
  const fullscreenBtn = document.getElementById('fullscreen-btn');

  function checkAuth() {
    if (sessionStorage.getItem('band_authenticated') === 'true') {
      if(loginScreen) loginScreen.style.display = 'none';
      if(dashboardContent) dashboardContent.classList.remove('hidden');
    } else {
      if(loginScreen) loginScreen.style.display = 'flex';
      if(dashboardContent) dashboardContent.classList.add('hidden');
    }
  }

  loginBtn?.addEventListener('click', () => {
    if (passwordInput.value === MASTER_PASSWORD) {
      sessionStorage.setItem('band_authenticated', 'true');
      if(loginError) loginError.style.display = 'none';
      checkAuth();
    } else {
      if(loginError) loginError.style.display = 'block';
      passwordInput.value = "";
    }
  });

  passwordInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') loginBtn?.click();
  });

  logoutBtn?.addEventListener('click', () => {
    sessionStorage.removeItem('band_authenticated');
    checkAuth();
  });

  fullscreenBtn?.addEventListener('click', () => {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch((err) => {
        alert(`Chyba fullscreenu: ${err.message}`);
      });
    } else {
      document.exitFullscreen();
    }
  });

  checkAuth();
</script>