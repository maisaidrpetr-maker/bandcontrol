---
// src/pages/index.astro
---
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body {
        margin: 0;
        background-color: #050505;
        height: 100vh;
        /* Flexbox pro vystředění na všech zařízeních */
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .logo {
        /* Responzivní šířka: obrázek nikdy nepřesáhne 80 % šířky displeje */
        width: 80%;
        /* Maximální šířka, aby logo nebylo na desktopu zbytečně obří */
        max-width: 400px;
        height: auto; /* Zachová poměr stran */
        display: block;
      }
    </style>
  </head>
  <body>
    <img src="/images/bms.png" alt="BandControl Logo" class="logo" />

    <script>
      setTimeout(() => {
        window.location.href = '/login';
      }, 2000);
    </script>
  </body>
</html>