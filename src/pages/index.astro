---
// src/pages/index.astro
import NavigationDrawer from '../components/NavigationDrawer.astro';

// 1. Definice typu pro databázi uživatelů
interface UserDatabase {
  [key: string]: string;
}

// 2. Databáze hesel a jmen (kluci z kapely a jejich přístupy)
const USERS: UserDatabase = {
  "petrm": "Petr Maišaidr (Kytara)",
  "jank": "Honza Kolář (Mandolína)",
  "janan": "Jana Novotná (Housle)",
  "zuzkab": "Zuzana Bartoňová (Zpěv)",
  "zbynekb": "Zbyněk Bartoň (Banjo)",
  "martink": "Martin Král (Kontrabas)"
};
---

<html lang="cs">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BandControl</title>
  <style>
    /* --- GLOBÁLNÍ DESIGN (CHYTRÝ & RESPONSIVNÍ) --- */
    :root {
      --bg-dark: #09090b;
      --bg-card: #141416;
      --border-color: #27272a;
      --text-main: #f4f4f5;
      --text-muted: #a1a1aa;
      --red: #ef4444;
      --blue: #3b82f6;
      --amber: #f59e0b;
      --green: #22c55e;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    /* --- 1. LOGIN FORMULÁŘ --- */
    .login-container {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .login-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      padding: 40px 30px;
      border-radius: 12px;
      width: 100%;
      max-width: 400px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      text-align: center;
    }

    .login-card h1 {
      font-size: 24px;
      margin-bottom: 10px;
      letter-spacing: 1px;
    }

    .login-card p {
      color: var(--text-muted);
      font-size: 14px;
      margin-bottom: 30px;
    }

    .input-group {
      margin-bottom: 20px;
      text-align: left;
    }

    .input-group label {
      display: block;
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .login-input {
      width: 100%;
      background: #09090b;
      border: 1px solid var(--border-color);
      padding: 14px;
      border-radius: 6px;
      color: white;
      font-size: 16px;
      outline: none;
      transition: border-color 0.2s;
    }

    .login-input:focus {
      border-color: var(--blue);
    }

    .btn-primary {
      width: 100%;
      background: var(--blue);
      color: white;
      border: none;
      padding: 14px;
      border-radius: 6px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.2s;
    }

    .btn-primary:hover {
      opacity: 0.9;
    }

    .error-msg {
      color: var(--red);
      font-size: 14px;
      margin-top: 15px;
      display: none;
    }

    /* --- 2. HLAVNÍ DASHBOARD --- */
    .dashboard-layout {
      padding: 20px;
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
    }

    .main-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 30px;
      gap: 15px;
    }

    .user-info h2 {
      font-size: 20px;
    }

    .user-info p {
      color: var(--text-muted);
      font-size: 14px;
    }

    .header-actions {
      display: flex;
      gap: 10px;
    }

    .btn-sec {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      color: white;
      padding: 10px 16px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 14px;
    }

    .btn-ghost {
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-muted);
      padding: 10px 16px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 14px;
    }

    .btn-ghost:hover {
      color: var(--red);
    }

    /* Mřížka modulů - plně responsivní */
    .grid-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
    }

    /* Pomocná třída pro skrytí prvků */
    .hidden {
      display: none !important;
    }

    /* --- CSS PRO PŘETLAČENÍ ŠUPLÍKU NA PRAVOU STRANU (Nešahej na komponentu) --- */
    #drawer-handle, .drawer-hardware-handle {
      left: auto !important;
      right: 0 !important;
      border-left: 1px solid var(--border-color) !important;
      border-right: none !important;
      border-radius: 8px 0 0 8px !important;
    }

    #drawer-handle.open, .drawer-hardware-handle.open {
      left: auto !important;
      right: 300px !important;
      border-radius: 0 !important;
      border-left: none !important;
    }

    #navigation-drawer, .nav-drawer {
      left: auto !important;
      right: -300px !important;
      border-left: 1px solid var(--border-color) !important;
      border-right: none !important;
      box-shadow: -5px 0 25px rgba(0, 0, 0, 0.7) !important;
    }

    #navigation-drawer.open, .nav-drawer.open {
      left: auto !important;
      right: 0 !important;
    }
  </style>
</head>
<body>

  <div id="login-screen" class="login-container">
    <div class="login-card">
      <h1>BANDCONTROL</h1>
      <p>Vstup pro členy kapely</p>
      
      <form id="login-form" onsubmit="return false;">
        <div class="input-group">
          <label for="band-password">Zadej své osobní heslo</label>
          <input 
            type="password" 
            id="band-password" 
            class="login-input" 
            placeholder="••••••••" 
            autocomplete="current-password"
          />
        </div>
        <button type="submit" id="login-submit-btn" class="btn-primary">Vstoupit do aplikace</button>
        <p id="login-error" class="error-msg">⚠️ Nesprávné heslo, zkus to znovu.</p>
      </form>
    </div>
  </div>

  <main id="dashboard-content" class="dashboard-layout hidden">
    
    <NavigationDrawer />

    <header class="main-header">
      <div class="user-info">
        <h2 id="welcome-user">Ahoj!</h2>
        <p>Vítej v palubním počítači</p>
      </div>
      <div class="header-actions">
        <button id="fullscreen-btn" class="btn-sec">🖥️ Celá obrazovka</button>
        <button id="logout-btn" class="btn-ghost">Odhlásit</button>
      </div>
    </header>

    <div class="grid-container">
      </div>
  </main>

  <script define:vars={{ USERS }}>
    const loginScreen = document.getElementById('login-screen');
    const dashboardContent = document.getElementById('dashboard-content');
    const passwordInput = document.getElementById('band-password');
    const loginBtn = document.getElementById('login-submit-btn');
    const loginError = document.getElementById('login-error');
    const welcomeUser = document.getElementById('welcome-user');
    const logoutBtn = document.getElementById('logout-btn');
    const fullscreenBtn = document.getElementById('fullscreen-btn');

    // Kontrola, zda je uživatel už přihlášen
    function checkAuth() {
      const loggedUser = sessionStorage.getItem('band_user');
      if (loggedUser) {
        if (loginScreen) loginScreen.classList.add('hidden');
        if (dashboardContent) dashboardContent.classList.remove('hidden');
        if (welcomeUser) welcomeUser.textContent = `Ahoj, ${loggedUser}!`;
      } else {
        if (loginScreen) loginScreen.classList.remove('hidden');
        if (dashboardContent) dashboardContent.classList.add('hidden');
      }
    }

    // Vyhodnocení hesla
    function handleLogin() {
      if (!passwordInput) return;
      const password = passwordInput.value.trim().toLowerCase();

      if (password in USERS) {
        const userName = USERS[password];
        sessionStorage.setItem('band_user', userName);
        if (loginError) loginError.style.display = 'none';
        passwordInput.value = "";
        checkAuth();
      } else {
        if (loginError) loginError.style.display = 'block';
        passwordInput.value = "";
        passwordInput.focus();
      }
    }

    // Event Listenery pro přihlášení
    loginBtn?.addEventListener('click', handleLogin);
    passwordInput?.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') handleLogin();
    });

    // Odhlášení
    logoutBtn?.addEventListener('click', () => {
      sessionStorage.removeItem('band_user');
      checkAuth();
    });

    // Fullscreen režim pro stage
    fullscreenBtn?.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen();
      }
    });

    // Spuštění kontroly při načtení stránky
    checkAuth();
  </script>
</body>
</html>