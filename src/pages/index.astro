---
// src/pages/index.astro
import '../styles/global.css';
---
<html lang="cs" style="height: 100%;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      html, body {
        height: 100%;
        margin: 0;
      }
      body {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
      }
      .content-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        flex: 1;
        width: 100%;
      }
      .logo {
        width: 80%;
        max-width: 400px;
        height: auto;
        display: block;
      }
      footer {
        width: 100%;
        padding: 20px 0;
        border-top: 1px solid #27272a;
        text-align: center;
        color: #71717a;
        font-size: 0.8rem;
        background: #09090b;
      }
    </style>
  </head>
  <body>
    <div class="content-wrapper">
      <img src="/images/bms.png" alt="BandControl Logo" class="logo" />
    </div>

    <footer>
      <p style="margin: 0;">BandControl &copy; 2026 | Správa repertoáru a playlistů</p>
    </footer>

    <script>
      setTimeout(() => {
        window.location.href = '/login';
      }, 2000);
    </script>
  </body>
</html>