---
// src/pages/splashscreen.astro
import '../styles/global.css';
---
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <title>Start | BandControl</title>
    <style>
      body {
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .logo {
        width: 300px;
        animation: fadeIn 2s ease-in;
      }
      @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    </style>
  </head>
  <body>
    <img src="/bms.png" alt="Logo" class="logo" />

    <script>
      setTimeout(() => {
        window.location.href = '/login';
      }, 2500);
    </script>
  </body>
</html>