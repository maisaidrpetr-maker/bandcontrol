---
export const prerender = false;

import { getCollection } from 'astro:content';
import { createClient } from 'redis';
import NavigationDrawer from '../components/NavigationDrawer.astro';
import Header from '../components/Header.astro';

const allLyrics = await getCollection('lyrics');
const lyricsMap = Object.fromEntries(
  allLyrics.map(s => {
    const data = s.data as any;
    let capoVal = data.capo;
    if (capoVal === undefined || capoVal === null || capoVal === '' || capoVal === '-' || capoVal === 0) {
      capoVal = '';
    }
    return [
      s.id, 
      {
        title: data.title || s.id,
        key: data.key || '',
        capo: capoVal
      }
    ];
  })
);

const client = createClient({
  url: import.meta.env.REDIS_URL
});

client.on('error', () => {});
await client.connect().catch(() => {});

let activePlaylist = null;
try {
  const activeId = await client.get('bandcontrol:active_playlist') || await client.get('active_playlist');
  if (activeId) {
    const rawPlaylists = await client.get('bandcontrol:playlists');
    const playlists = rawPlaylists ? JSON.parse(rawPlaylists) : [];
    activePlaylist = playlists.find((p: any) => p.id === activeId);
  }
} catch (err) {
  console.error('Chyba při načítání stage dat:', err);
}
await client.disconnect().catch(() => {});
---

<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <title>BandControl — Stage (Živý setlist)</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      :root { --bg-dark: #050505; --text-main: #f4f4f5; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background-color: var(--bg-dark);
        color: var(--text-main);
        font-family: system-ui, sans-serif;
        min-height: 100vh;
      }
      .dashboard-layout {
        width: 100%;
        display: flex;
        flex-direction: column;
      }
      .stage-container {
        max-width: 800px;
        margin: 15px auto;
        padding: 0 15px;
        width: 100%;
      }
      h1 { 
        color: #ff8800; 
        font-size: 1.5rem; 
        margin-bottom: 20px; 
        text-align: center; 
      }
      
      .song-card {
        background: linear-gradient(180deg, #1c1c1c 0%, #111 100%);
        border: 1px solid #333;
        padding: 10px 15px;
        margin-bottom: 8px;
        border-radius: 6px;
        font-size: 1.1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .song-left {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 600;
      }
      .song-index {
        color: #ff8800;
        min-width: 24px;
      }
      .song-meta {
        display: flex;
        gap: 8px;
        font-size: 0.9rem;
        align-items: center;
      }
      .badge {
        background: #222;
        border: 1px solid #444;
        padding: 2px 10px;
        border-radius: 4px;
        color: #ff8800;
        font-weight: bold;
        min-width: 36px;
        text-align: center;
      }
      .badge-placeholder {
        visibility: hidden;
        padding: 2px 10px;
        min-width: 36px;
      }
      .empty { color: #666; font-style: italic; margin-top: 40px; text-align: center; font-size: 1.1rem; }
    </style>
  </head>
  <body>
    <script is:inline>
      if (!sessionStorage.getItem('jePrihlasen')) window.location.href = '/login';
    </script>

    <main class="dashboard-layout">
      <NavigationDrawer />
      <Header />

      <div class="stage-container">
        <h1>{activePlaylist ? activePlaylist.name : 'ŽÁDNÝ AKTIVNÍ PLAYLIST'}</h1>
        
        {activePlaylist ? (
          <div class="song-list">
            {activePlaylist.songs.map((songId: string, index: number) => {
              const song = lyricsMap[songId] || { title: songId, key: '', capo: '' };
              return (
                <div class="song-card">
                  <div class="song-left">
                    <span class="song-index">{index + 1}.</span>
                    <span>{song.title}</span>
                  </div>
                  <div class="song-meta">
                    {song.key ? <div class="badge">{song.key}</div> : <div class="badge badge-placeholder">-</div>}
                    {song.capo !== '' ? (
                      <div class="badge" style="color: #aaa; font-weight: normal;">C{song.capo}</div>
                    ) : (
                      <div class="badge badge-placeholder">C-</div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="empty">Zatím není nastaven žádný aktivní playlist. Vyber ho v administraci.</div>
        )}
      </div>
    </main>
  </body>
</html>