---
// src/pages/stage.astro
export const prerender = false;

import { getCollection } from 'astro:content';
import { createClient } from 'redis';
import '../styles/global.css';
import NavigationDrawer from '../components/NavigationDrawer.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro'; // Předpokládám, že Footer komponentu takto importuješ, případně ji uprav dle projektu

const allLyrics = await getCollection('lyrics');
const lyricsMap = Object.fromEntries(
  allLyrics.map(s => {
    const data = s.data as any;
    let capoVal = data.capo;
    if (capoVal === undefined || capoVal === null || capoVal === '' || capoVal === '-' || capoVal === 0) {
      capoVal = '';
    }
    return [
      s.id, 
      {
        title: data.title || s.id,
        key: data.key || '',
        capo: capoVal
      }
    ];
  })
);

const client = createClient({
  url: import.meta.env.REDIS_URL
});

client.on('error', () => {});
await client.connect().catch(() => {});

let activePlaylist: any = null;
try {
  const url = Astro.url;
  const requestedPlaylistId = url.searchParams.get('playlist');

  const rawPlaylists = await client.get('bandcontrol:playlists');
  const playlists = rawPlaylists ? JSON.parse(rawPlaylists) : [];

  if (requestedPlaylistId) {
    activePlaylist = playlists.find((p: any) => p.id === requestedPlaylistId);
  }

  if (!activePlaylist) {
    const activeId = await client.get('bandcontrol:active_playlist') || await client.get('active_playlist');
    if (activeId) {
      activePlaylist = playlists.find((p: any) => p.id === activeId);
    }
  }
} catch (err) {
  console.error('Chyba při načítání stage dat:', err);
}
await client.disconnect().catch(() => {});
---

<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <title>Blue Heart — aktuální playlist</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      .dashboard-layout {
        width: 100%;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      .stage-content-wrapper {
        flex: 1; /* Zajistí, že obsah roztáhne stránku, aby footer zůstal dole */
      }
      .stage-container {
        max-width: 800px;
        margin: 15px auto;
        padding: 0 15px;
        width: 100%;
      }
      .stage-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 15px;
        flex-wrap: wrap;
      }
      h1 { 
        color: #ff8800; 
        font-size: 1.5rem; 
        margin: 0; 
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        letter-spacing: 0.5px;
      }
      .btn-print {
        background: linear-gradient(180deg, #ff8800 0%, #cc6a00 100%);
        border: none;
        color: #fff;
        padding: 8px 16px;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
        font-size: 0.8rem;
        letter-spacing: 1px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.5);
        transition: background 0.2s;
        white-space: nowrap;
      }
      .btn-print:hover {
        background: linear-gradient(180deg, #ff9922 0%, #dd7700 100%);
      }
      
      .song-card {
        background: linear-gradient(180deg, #1c1c1c 0%, #111 100%);
        border: 1px solid #333;
        padding: 10px 15px;
        margin-bottom: 8px;
        border-radius: 6px;
        font-size: 1.1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .song-left {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 600;
      }
      .song-index {
        color: #ff8800;
        min-width: 24px;
      }
      .song-meta {
        display: grid;
        grid-template-columns: 45px 55px;
        gap: 8px;
        align-items: center;
        justify-items: center;
      }
      .badge-slot {
        display: flex;
        justify-content: center;
        width: 100%;
      }
      .badge {
        background: #222;
        border: 1px solid #444;
        padding: 4px 0;
        border-radius: 4px;
        color: #ff8800;
        font-weight: bold;
        width: 100%;
        text-align: center;
      }
      .badge-placeholder {
        visibility: hidden;
        padding: 4px 0;
        width: 100%;
      }
      .empty { color: #666; font-style: italic; margin-top: 40px; text-align: center; font-size: 1.1rem; }

      .print-logo {
        display: none;
      }

      /* Skrytí tiskového předělu v normálním zobrazení na stage */
      .print-header-second {
        display: none !important;
        visibility: hidden !important;
        height: 0 !important;
        overflow: hidden !important;
        margin: 0 !important;
        padding: 0 !important;
        border: none !important;
      }

      /* Tiskové styly */
      @page {
        size: auto;
        margin: 12mm 10mm;
      }

      @media print {
        body * {
          visibility: hidden;
        }
        .stage-container, .stage-container * {
          visibility: visible;
        }
        .stage-container {
          position: absolute;
          left: 0;
          top: 0;
          width: 100%;
          margin: 0;
          padding: 25px 10mm 0 10mm !important;
          color: #000 !important;
          background: #fff !important;
        }
        
        .stage-header-row {
          display: grid !important;
          grid-template-columns: auto 1fr auto !important;
          align-items: center !important;
          width: 100% !important;
          background: #e6e6e6 !important;
          padding: 8px 15px 8px 135px !important;
          min-height: 50px !important;
          position: relative !important;
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
          page-break-after: avoid !important;
          break-after: avoid !important;
          page-break-inside: avoid !important;
          break-inside: avoid !important;
        }

        .stage-container:has(.print-header-second) > .stage-header-row:first-of-type::after {
          content: "1/2" !important;
          font-weight: bold !important;
          font-size: 1.4rem !important;
          color: #333 !important;
          padding-right: 5px !important;
          justify-self: end !important;
        }

        .print-header-second {
          display: flex !important;
          visibility: visible !important;
          height: auto !important;
          overflow: visible !important;
          page-break-before: always !important;
          break-before: page !important;
          margin-top: 25px !important; 
        }

        .stage-container:has(.print-header-second) .print-header-second::after {
          content: "2/2" !important;
          font-weight: bold !important;
          font-size: 1.4rem !important;
          color: #333 !important;
          padding-right: 5px !important;
          justify-self: end !important;
        }

        .print-logo {
          display: block !important;
          position: absolute !important;
          left: 15px !important;
          top: -20px !important;
          height: 100px !important;
          width: auto !important;
          z-index: 10 !important;
        }

        .stage-header-row h1 {
          color: #000 !important;
          border: none !important;
          margin: 0 !important;
          font-size: 2.2rem !important;
          text-align: left !important;
          background: transparent !important;
          padding: 0 !important;
          letter-spacing: 0.5px;
          font-weight: bold !important;
          font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
          flex-grow: 1 !important;
        }

        .btn-print {
          display: none !important;
        }

        .song-list {
          margin-top: 5px;
          display: block !important;
        }
        .song-card {
          background: #fff !important;
          border: none !important;
          box-shadow: none !important;
          background-image: linear-gradient(to bottom, #777, #777) !important;
          background-size: 100% 1px !important;
          background-position: bottom !important;
          background-repeat: no-repeat !important;
          color: #000 !important;
          padding: 4px 6px 6px 6px !important;
          margin-bottom: 0 !important;
          font-size: 1.8rem !important;
          line-height: 1.2 !important;
          border-radius: 0 !important;
          page-break-inside: avoid !important;
          break-inside: avoid !important;
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }

        .song-left {
          gap: 15px !important;
        }
        .song-index {
          color: #000 !important;
          font-weight: bold;
          min-width: 45px;
        }
        .song-meta {
          display: flex !important;
          gap: 20px !important;
        }
        .badge-slot {
          display: inline-block !important;
          width: auto !important;
        }
        .badge {
          background: transparent !important;
          border: none !important;
          font-weight: bold !important;
          font-size: 1.8rem !important;
          padding: 0 !important;
          width: 50px !important;
          min-width: 50px !important;
          text-align: center !important;
          display: inline-block !important;
        }
        .badge.print-key {
          color: #d00000 !important;
        }
        .badge.print-capo {
          color: #000 !important;
        }
        .badge-placeholder {
          display: inline-block !important;
          visibility: hidden !important;
          background: transparent !important;
          border: none !important;
          padding: 0 !important;
          width: 50px !important;
          min-width: 50px !important;
        }
      }
    </style>
  </head>
  <body>
    <script is:inline>
      if (!sessionStorage.getItem('jePrihlasen')) window.location.href = '/login';
    </script>

    <main class="dashboard-layout">
      <NavigationDrawer />
      <Header />

      <div class="stage-content-wrapper">
        <div class="stage-container">
          <div class="stage-header-row">
            <img src="/images/BHlogo.png" alt="Logo kapely" class="print-logo" />
            <h1>{activePlaylist ? activePlaylist.name : 'ŽÁDNÝ PLAYLIST NENALEZEN'}</h1>
            {activePlaylist && (
              <button id="print-btn" class="btn-print">🖨️ TISK / ULOŽIT</button>
            )}
          </div>
          
          {activePlaylist ? (
            <div class="song-list">
              {activePlaylist.songs.map((songId: string, index: number) => {
                const song = lyricsMap[songId] || { title: songId, key: '', capo: '' };
                const isTwentyFirst = index === 20;
                return (
                  <>
                    {isTwentyFirst && (
                      <div class="stage-header-row print-header-second">
                        <img src="/images/BHlogo.png" alt="Logo kapely" class="print-logo" />
                        <h1>{activePlaylist.name}</h1>
                      </div>
                    )}
                    <div class="song-card">
                      <div class="song-left">
                        <span class="song-index">{index + 1}.</span>
                        <span>{song.title}</span>
                      </div>
                      <div class="song-meta">
                        <div class="badge-slot">
                          {song.key ? <div class="badge print-key">{song.key}</div> : <div class="badge badge-placeholder">&nbsp;</div>}
                        </div>
                        <div class="badge-slot">
                          {song.capo !== '' ? <div class="badge print-capo">C{song.capo}</div> : <div class="badge badge-placeholder">&nbsp;</div>}
                        </div>
                      </div>
                    </div>
                  </>
                );
              })}
            </div>
          ) : (
            <div class="empty">Požadovaný playlist nebyl nalezen nebo není nastavený.</div>
          )}
        </div>
      </div>

      <Footer />
    </main>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('print') === 'true') {
          setTimeout(() => {
            window.print();
          }, 300);
        }
      });

      document.addEventListener('click', (e) => {
        if (e.target.closest('#logout-btn')) {
          sessionStorage.clear();
          window.location.href = '/login';
        }
        if (e.target.closest('#print-btn')) {
          window.print();
        }
      });
    </script>
  </body>
</html>